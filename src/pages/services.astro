                  src={plan.caseImage}
                  alt={`${plan.caseName} 预览`}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
              </a>
            </div>
            <div class="p-4">
              <h3 class="mb-1 text-lg font-semibold text-foreground dark:text-foreground-dark">
                {plan.caseName}
              </h3>
              <p class="mb-3 text-sm text-foreground-muted dark:text-slate-300">
                {plan.description}
              </p>
              <a
                href={plan.caseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300"
              >
                访问网站 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="mx-auto mb-24 w-full max-w-6xl rounded-3xl border border-brand-500/20 bg-brand-500/10 px-6 py-12 text-center shadow-brand-md md:px-12">
      <h2 class="text-3xl font-semibold text-brand-700 md:text-4xl dark:text-brand-100" data-i18n="cta.title">
        准备开始您的项目？
      </h2>
      <p class="mt-4 text-base text-brand-800/80 dark:text-brand-200/80" data-i18n="cta.subtitle">
        联系我们的专业团队，获取定制化的网站开发解决方案。
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <button type="button" data-contact-btn class="btn-primary">
          联系客服
        </button>
        <a class="btn-secondary" href="/">
          返回首页
        </a>
      </div>
    </section>
  </div>

  <!-- 客服微信弹窗 -->
  <div
    id="contact-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
    data-modal
  >
    <div class="relative mx-auto w-full max-w-md max-h-[90vh] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-700 dark:bg-slate-900">
      <button
        type="button"
        data-modal-close
        class="absolute right-4 top-4 rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300"
        aria-label="关闭"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <div class="text-center">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-brand-500/10">
          <svg class="h-6 w-6 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
        </div>
        
        <h3 class="mb-1.5 text-lg font-semibold text-foreground dark:text-foreground-dark">
          联系客服
        </h3>
        <p class="mb-4 text-sm text-foreground-muted dark:text-slate-300">
          请添加我们的客服微信，我们将尽快为您提供服务
        </p>
        
        <div class="mb-4 rounded-xl border-2 border-brand-500/30 bg-brand-500/5 p-3">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-foreground-muted dark:text-slate-400">
            客服微信
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-3">
            <code class="rounded-lg bg-white px-3 py-1.5 text-base font-mono font-semibold text-brand-600 dark:bg-slate-800 dark:text-brand-400">
              {wechatId}
            </code>
            <button
              type="button"
              data-copy-wechat
              class="rounded-lg border border-brand-500 bg-brand-500 px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-brand-600"
            >
              复制
            </button>
          </div>
        </div>

        <div class="mb-2">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-foreground-muted dark:text-slate-400">
            扫码添加
          </p>
          <div class="flex flex-col items-center gap-2">
            <div class="flex items-center justify-center rounded-xl border-2 border-slate-200 bg-white p-2 shadow-sm dark:border-slate-700 dark:bg-slate-900">
              <img
                src="/wechat-qr-popup-service.png"
                alt="Popup Service 客服微信二维码"
                loading="lazy"
                decoding="async"
                class="max-w-[280px] h-auto object-contain"
              />
            </div>
            <p class="text-xs text-center text-foreground-muted dark:text-slate-400 px-2 pb-2">
              扫一扫二维码，或直接搜索微信号 <span class="font-semibold text-brand-600 dark:text-brand-400">{wechatId}</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ wechatId, translations }}>
  // Get language from storage or URL
  function getLanguage() {
    const stored = localStorage.getItem('language');
    const urlLang = new URLSearchParams(window.location.search).get('lang');
    return (urlLang === 'en' || urlLang === 'zh') ? urlLang : (stored === 'en' || stored === 'zh') ? stored : 'zh';
  }
  
  // Update all texts on page load
  function updatePageTexts(lang) {
    const t = translations[lang];
    if (!t) return;
    
    // Update elements with data-i18n attribute
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value = t;
        for (const k of keys) {
          value = value?.[k];
        }
        if (value && typeof value === 'string') {
          el.textContent = value;
        }
      }
    });
    
    // Update plan names and descriptions
    const planNames = {
      standard: t.services.plans.standard,
      'standard-pro': t.services.plans.standardPro,
      custom: t.services.plans.custom
    };
    
    document.querySelectorAll('[data-plan-name]').forEach((el) => {
      const planId = el.getAttribute('data-plan-name');
      if (planId && planNames[planId]) {
        el.textContent = planNames[planId];
      }
    });
    
    // Update plan descriptions
    const planDescriptions = {
      standard: lang === 'zh' ? '适合初创企业和个人项目 | 优质设计（初级）' : 'Suitable for startups and personal projects | Premium Design',
      'standard-pro': lang === 'zh' ? '适合成长型企业和专业需求 | 优质设计（初级）' : 'Suitable for growing businesses and professional needs | Premium Design',
      custom: lang === 'zh' ? '适合大型企业和复杂项目 | 顶级设计（高级）' : 'Suitable for large enterprises and complex projects | Top-tier Design'
    };
    
    document.querySelectorAll('[data-plan-desc]').forEach((el) => {
      const planId = el.getAttribute('data-plan-desc');
      if (planId && planDescriptions[planId]) {
        el.textContent = planDescriptions[planId];
      }
    });
    
    // Update feature labels in comparison table
    const featureLabelMap = {
      '交付': t.services?.features?.delivery || (lang === 'zh' ? '交付' : 'Delivery'),
      '设计': t.services?.features?.design || (lang === 'zh' ? '设计' : 'Design'),
      '响应式设计': t.services?.features?.responsive || (lang === 'zh' ? '响应式设计' : 'Responsive Design'),
      '移动优先设计': t.services?.features?.mobileFirst || (lang === 'zh' ? '移动优先设计' : 'Mobile-First Design'),
      '跨浏览器兼容': t.services?.features?.crossBrowser || (lang === 'zh' ? '跨浏览器兼容' : 'Cross-Browser Compatibility'),
      '部署': t.services?.features?.deployment || (lang === 'zh' ? '部署' : 'Deployment'),
      '页面数量': t.services?.features?.pageCount || (lang === 'zh' ? '页面数量' : 'Page Count'),
      '维护': t.services?.features?.maintenance || (lang === 'zh' ? '维护' : 'Maintenance'),
      'SEO': 'SEO',
      '交付周期': t.services?.features?.deliveryCycle || (lang === 'zh' ? '交付周期' : 'Delivery Cycle'),
      '修改': t.services?.features?.revisions || (lang === 'zh' ? '修改' : 'Revisions'),
      '分析支持': t.services?.features?.analysis || (lang === 'zh' ? '分析支持' : 'Analysis Support'),
      '客服与语言': t.services?.features?.support || (lang === 'zh' ? '客服与语言' : 'Support & Language'),
      '合规与政策': t.services?.features?.compliance || (lang === 'zh' ? '合规与政策' : 'Compliance & Policy'),
      '数据追踪': t.services?.features?.tracking || (lang === 'zh' ? '数据追踪' : 'Data Tracking'),
      '品牌设计': t.services?.features?.branding || (lang === 'zh' ? '品牌设计' : 'Brand Design')
    };
    
    document.querySelectorAll('[data-feature-label]').forEach((el) => {
      const originalLabel = el.getAttribute('data-feature-label');
      if (originalLabel && featureLabelMap[originalLabel]) {
        el.textContent = featureLabelMap[originalLabel];
      }
    });
    
    // Update plan names in comparison table headers
    document.querySelectorAll('th').forEach((th) => {
      const planName = th.textContent?.trim();
      if (planName === '标准') {
        th.textContent = t.services.plans.standard;
      } else if (planName === '标准 Pro') {
        th.textContent = t.services.plans.standardPro;
      } else if (planName === '全定制') {
        th.textContent = t.services.plans.custom;
      }
    });
  }
  
  // Initialize language
  document.addEventListener('DOMContentLoaded', () => {
    const lang = getLanguage();
    updatePageTexts(lang);
  });
  
  // Listen for language changes
  window.addEventListener('languagechange', ((e: CustomEvent) => {
    updatePageTexts(e.detail.lang);
  }) as EventListener);
  
  window.addEventListener('storage', (e) => {
    if (e.key === 'language') {
      const newLang = e.newValue || 'zh';
      updatePageTexts(newLang);
    }
  });
  
  // 弹窗控制
  const modal = document.getElementById('contact-modal');
  const contactButtons = document.querySelectorAll('[data-contact-btn]');
  const closeButton = document.querySelector('[data-modal-close]');
  const copyButton = document.querySelector('[data-copy-wechat]');

  // 打开弹窗
  contactButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    });
  });

  // 关闭弹窗
  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  if (closeButton) {
    closeButton.addEventListener('click', closeModal);
  }

  // 点击背景关闭
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  // ESC 键关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // 复制微信号
  if (copyButton) {
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(wechatId);
        const originalText = copyButton.textContent;
        copyButton.textContent = '已复制';
        copyButton.classList.add('bg-green-500', 'hover:bg-green-600');
        copyButton.classList.remove('bg-brand-500', 'hover:bg-brand-600');
        
        setTimeout(() => {
          copyButton.textContent = originalText;
          copyButton.classList.remove('bg-green-500', 'hover:bg-green-600');
          copyButton.classList.add('bg-brand-500', 'hover:bg-brand-600');
        }, 2000);
      } catch (err) {
        console.error('复制失败:', err);
        // 降级方案：使用文本选择
        const textArea = document.createElement('textarea');
        textArea.value = wechatId;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand('copy');
          copyButton.textContent = '已复制';
          setTimeout(() => {
            copyButton.textContent = '复制';
          }, 2000);
        } catch (err) {
          alert('复制失败，请手动复制：' + wechatId);
        }
        document.body.removeChild(textArea);
      }
    });
  }


  // 查看详细对比按钮 - 滚动到详细对比表格
  document.querySelectorAll('[data-view-details]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const comparisonSection = document.getElementById('detailed-comparison');
      if (comparisonSection) {
        comparisonSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

