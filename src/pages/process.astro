---
import Layout from '../layouts/Layout.astro';
import { COMPANY_NAME } from '../config/site';
import { translations } from '../i18n/translations';

// Get initial language
const urlLang = Astro.url.searchParams.get('lang');
const initialLang = (urlLang === 'en' || urlLang === 'zh') ? urlLang : 'zh';

// Process steps data with unique images matching captions
const processSteps = [
  {
    id: '1',
    name: '需求分析',
    nameEn: 'Requirements Analysis',
    title: '探索与定义：项目的基石',
    titleEn: 'Exploration & Definition: The Foundation of Projects',
    description: '我们通过与客户的深入沟通，全面了解项目背景、业务目标、目标用户群体和核心功能需求。通过用户访谈、市场调研和数据分析，我们明确项目的设计方向和功能范围，确保最终产品能够真正解决用户问题并满足业务目标。',
    descriptionEn: 'Through in-depth communication with clients, we comprehensively understand project background, business objectives, target user groups, and core functional requirements. Through user interviews, market research, and data analysis, we clarify the design direction and functional scope of the project, ensuring the final product truly solves user problems and meets business goals.',
    images: [
      {
        url: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop&q=80',
        caption: '用户画像分析',
        captionEn: 'User Persona Analysis'
      },
      {
        url: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop&q=80',
        caption: '竞品分析研究',
        captionEn: 'Competitive Analysis Research'
      },
      {
        url: 'https://images.unsplash.com/photo-1553877522-43269d4ea984?w=800&h=600&fit=crop&q=80',
        caption: '需求文档整理',
        captionEn: 'Requirements Documentation'
      }
    ]
  },
  {
    id: '2',
    name: 'UX 设计',
    nameEn: 'UX Design',
    title: '梳理逻辑：用户体验蓝图',
    titleEn: 'Logic Organization: User Experience Blueprint',
    description: '基于需求分析的结果，我们制定完整的用户体验策略。通过创建用户旅程地图，我们梳理用户在使用产品过程中的每个接触点和情感体验。同时，我们设计清晰的信息架构，规划合理的导航结构和内容组织方式，确保用户能够轻松找到所需信息。我们还绘制关键任务流程图，优化用户完成核心任务的路径，提升产品的易用性和用户满意度。',
    descriptionEn: 'Based on the results of requirements analysis, we develop a complete user experience strategy. By creating user journey maps, we organize every touchpoint and emotional experience users have when using the product. At the same time, we design clear information architecture, plan reasonable navigation structures and content organization methods, ensuring users can easily find the information they need. We also draw key task flow diagrams to optimize the paths users take to complete core tasks, improving product usability and user satisfaction.',
    images: [
      {
        url: 'https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?w=800&h=600&fit=crop&q=80',
        caption: '用户旅程地图设计',
        captionEn: 'User Journey Map Design'
      },
      {
        url: 'https://images.unsplash.com/photo-1558655146-364adaf1fcc9?w=800&h=600&fit=crop&q=80',
        caption: '信息架构规划',
        captionEn: 'Information Architecture Planning'
      },
      {
        url: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=800&h=600&fit=crop&q=80',
        caption: '交互流程设计',
        captionEn: 'Interaction Flow Design'
      }
    ]
  },
  {
    id: '3',
    name: '低保真原型图',
    nameEn: 'Low-Fidelity Prototype',
    title: '骨架构建：快速迭代验证',
    titleEn: 'Skeleton Construction: Rapid Iteration & Validation',
    description: '在确定用户体验策略后，我们开始构建产品的骨架结构。首先，我们通过手绘草图快速记录设计想法，这些早期草稿帮助我们快速探索不同的布局方案。然后，我们使用专业工具创建数字线框图，详细展示每个页面的布局结构、功能模块和元素位置。这些低保真原型不包含视觉细节，专注于功能布局和交互逻辑，便于我们与客户和开发团队快速沟通，及时验证设计思路并进行调整优化。',
    descriptionEn: 'After determining the user experience strategy, we begin building the skeleton structure of the product. First, we quickly record design ideas through hand-drawn sketches, which help us quickly explore different layout solutions. Then, we use professional tools to create digital wireframes that detail the layout structure, functional modules, and element positions of each page. These low-fidelity prototypes do not include visual details, focusing on functional layout and interaction logic, making it easy for us to quickly communicate with clients and development teams, verify design ideas in time, and make adjustments and optimizations.',
    images: [
      {
        url: 'https://images.unsplash.com/photo-1513475382585-d06e58bcb0e0?w=800&h=600&fit=crop&q=80',
        caption: '手绘设计草图',
        captionEn: 'Hand-drawn Design Sketches'
      },
      {
        url: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=800&h=600&fit=crop&q=80',
        caption: '数字线框图设计',
        captionEn: 'Digital Wireframe Design'
      },
      {
        url: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&h=600&fit=crop&q=80',
        caption: '原型交互测试',
        captionEn: 'Prototype Interaction Testing'
      }
    ]
  },
  {
    id: '4',
    name: 'Mood Board',
    nameEn: 'Mood Board',
    title: '视觉探索：确立情感基调',
    titleEn: 'Visual Exploration: Establishing Emotional Tone',
    description: '在确定功能布局后，我们开始探索产品的视觉风格。我们收集大量设计灵感素材，包括色彩搭配、字体选择、图像风格、材质质感等视觉元素。通过整理这些素材，我们确定产品的整体视觉风格和情感基调，比如是专业严谨还是轻松活泼，是现代简约还是复古经典。这个阶段帮助我们统一设计语言，确保后续的视觉设计能够准确传达品牌形象和产品定位。',
    descriptionEn: 'After determining the functional layout, we begin exploring the visual style of the product. We collect a large number of design inspiration materials, including color combinations, font choices, image styles, material textures, and other visual elements. By organizing these materials, we determine the overall visual style and emotional tone of the product, such as professional and rigorous or relaxed and lively, modern and minimalist or retro and classic. This stage helps us unify the design language, ensuring that subsequent visual design can accurately convey brand image and product positioning.',
    images: [
      {
        url: 'https://images.unsplash.com/photo-1561070791-2526d30994b5?w=800&h=1000&fit=crop&q=80',
        caption: '色彩体系探索',
        captionEn: 'Color System Exploration',
        span: 2
      },
      {
        url: 'https://images.unsplash.com/photo-1541701494587-cb58502866ab?w=800&h=500&fit=crop&q=80',
        caption: '字体与排版风格',
        captionEn: 'Typography & Layout Style'
      },
      {
        url: 'https://images.unsplash.com/photo-1513475382585-d06e58bcb0e0?w=800&h=500&fit=crop&q=80',
        caption: '视觉风格参考',
        captionEn: 'Visual Style Reference'
      }
    ]
  },
  {
    id: '5',
    name: 'Design System',
    nameEn: 'Design System',
    title: '规范建立：一致性与复用',
    titleEn: 'Standardization: Consistency & Reusability',
    description: '为了确保设计的一致性和开发效率，我们建立完整的设计系统。设计系统包括基础组件库，如按钮、输入框、卡片等常用界面元素，每个组件都有明确的使用规范和交互状态。我们还定义设计变量（Design Tokens），包括颜色、字体、间距、圆角等设计属性的标准值，确保整个产品的视觉风格统一。此外，我们建立图标系统规范，确保图标风格一致且易于维护。这套设计系统不仅提高了设计效率，也为开发团队提供了清晰的实现指南。',
    descriptionEn: 'To ensure design consistency and development efficiency, we establish a complete design system. The design system includes a basic component library, such as buttons, input boxes, cards, and other common interface elements, each with clear usage specifications and interaction states. We also define design tokens, including standard values for design attributes such as colors, fonts, spacing, and border radius, ensuring unified visual style throughout the product. In addition, we establish icon system specifications to ensure consistent icon style and easy maintenance. This design system not only improves design efficiency but also provides clear implementation guidelines for the development team.',
    images: [
      {
        url: 'https://images.unsplash.com/photo-1558655146-364adaf1fcc9?w=800&h=600&fit=crop&q=80',
        caption: '组件库设计',
        captionEn: 'Component Library Design'
      },
      {
        url: 'https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?w=800&h=600&fit=crop&q=80',
        caption: '设计规范文档',
        captionEn: 'Design Specification Documentation'
      },
      {
        url: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=800&h=600&fit=crop&q=80',
        caption: '图标系统规范',
        captionEn: 'Icon System Specification'
      }
    ]
  },
  {
    id: '6',
    name: 'UI 设计成品',
    nameEn: 'UI Design Final',
    title: '最终交付：高保真视觉呈现',
    titleEn: 'Final Delivery: High-Fidelity Visual Presentation',
    description: '在设计系统建立后，我们开始进行高保真界面设计。我们根据前期的线框图和设计规范，完成每个页面的详细视觉设计，包括精确的颜色使用、字体排版、图标设计、图片选择等。我们注重每一个视觉细节，确保界面美观且符合品牌调性。同时，我们考虑不同设备和屏幕尺寸的适配，确保响应式设计的完美呈现。最终，我们输出完整的设计稿和开发交付文档，包括设计标注、切图资源、交互说明等，为开发团队提供清晰的实现依据，确保最终产品能够完美还原设计效果。',
    descriptionEn: 'After the design system is established, we begin high-fidelity interface design. Based on the previous wireframes and design specifications, we complete detailed visual design for each page, including precise color usage, typography, icon design, image selection, etc. We pay attention to every visual detail, ensuring the interface is beautiful and consistent with the brand tone. At the same time, we consider adaptation to different devices and screen sizes, ensuring perfect presentation of responsive design. Finally, we output complete design drafts and development handoff documents, including design annotations, image resources, interaction instructions, etc., providing clear implementation basis for the development team and ensuring the final product can perfectly restore the design effect.',
    images: [
      {
        url: 'https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=600&h=1000&fit=crop&q=80',
        caption: '高保真首页设计',
        captionEn: 'High-Fidelity Homepage Design',
        height: '500px'
      },
      {
        url: 'https://images.unsplash.com/photo-1558655146-364adaf1fcc9?w=600&h=1000&fit=crop&q=80',
        caption: '详情页设计',
        captionEn: 'Detail Page Design',
        height: '500px'
      },
      {
        url: 'https://images.unsplash.com/photo-1581291518633-83b4ebd1d83e?w=600&h=1000&fit=crop&q=80',
        caption: '设计交付文档',
        captionEn: 'Design Handoff Documentation',
        height: '500px'
      }
    ]
  }
];
---

<Layout 
  title={`服务流程 · ${COMPANY_NAME}`}
  description="了解我们的全链路设计流程，从需求分析到最终交付，我们为您提供完整的设计服务。"
>
  <div class="relative min-h-screen bg-surface dark:bg-surface-dark">
    <!-- Hero Section -->
    <section class="relative mx-auto w-full max-w-7xl px-4 pt-16 pb-8 md:px-6 md:pt-20 md:pb-12">
      <div class="absolute inset-x-0 -top-32 -z-10 h-[300px] bg-gradient-to-b from-brand-500/25 to-transparent blur-3xl"></div>
      <div class="text-center">
        <h1 class="text-3xl font-semibold leading-tight text-white md:text-4xl" data-i18n="process.title">
          全链路设计流程
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base text-gray-300" data-i18n="process.subtitle">
          从需求分析到最终交付，我们为您提供完整的设计服务流程
        </p>
      </div>
    </section>

    <!-- Process Container -->
    <section class="mx-auto w-full max-w-7xl px-4 pb-24 md:px-6">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-12">
        <!-- Left Sidebar: Timeline Navigation -->
        <aside class="lg:w-80 lg:shrink-0">
          <div class="sticky top-24 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-md">
            <h2 class="mb-6 text-xl font-bold text-white" data-i18n="process.title">
              全链路设计流程
            </h2>
            <div class="relative">
              <!-- Timeline Track -->
              <div class="absolute left-4 top-8 bottom-8 w-0.5 bg-white/10"></div>
              
              <ul class="relative space-y-4">
                {processSteps.map((step, index) => (
                  <li 
                    class={`timeline-item relative pl-10 cursor-pointer transition-all duration-300 ${
                      index === 0 ? 'active' : ''
                    }`}
                    data-target={`content-${step.id}`}
                    data-step-index={index}
                  >
                    <!-- Timeline Marker -->
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 h-4 w-4 rounded-full border-2 border-white/30 bg-white/5 transition-all duration-300 timeline-marker"></div>
                    
                    <!-- Timeline Text -->
                    <div class="rounded-xl px-4 py-2.5 text-sm font-medium text-gray-400 transition-all duration-300 timeline-text hover:bg-white/5 hover:text-brand-400">
                      <span data-step-name={step.id}>
                        {step.id}. {step.name}
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </aside>

        <!-- Right Content Area -->
        <main class="flex-1 min-w-0">
          {processSteps.map((step, index) => (
            <section 
              id={`content-${step.id}`}
              class={`content-section ${index === 0 ? 'active' : ''} ${index === 0 ? '' : 'hidden'}`}
              data-step-index={index}
            >
              <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-md md:p-10">
                <!-- Content Header -->
                <div class="mb-8">
                  <h2 class="mb-4 text-2xl font-bold text-white md:text-3xl" data-step-title={step.id}>
                    {step.title}
                  </h2>
                  
                  <!-- Detailed Description -->
                  <div class="mb-6 rounded-xl border border-white/5 bg-black/20 p-6">
                    <p class="leading-relaxed text-gray-300" data-step-description={step.id}>
                      {step.description}
                    </p>
                  </div>
                </div>

                <!-- Image Grid -->
                <div class={`image-grid grid gap-6 mb-8 ${
                  step.id === '4' 
                    ? 'grid-cols-1 md:grid-cols-2' 
                    : step.id === '6'
                    ? 'grid-cols-1 md:grid-cols-3'
                    : 'grid-cols-1 md:grid-cols-3'
                }`}>
                  {step.images.map((image) => (
                    <div 
                      class={`grid-item group relative overflow-hidden rounded-xl border border-white/10 bg-black/20 transition-all duration-300 hover:border-brand-400/50 hover:shadow-lg hover:shadow-brand-500/20 ${
                        image.span ? `md:col-span-${image.span}` : ''
                      }`}
                    >
                      <div class="relative aspect-video overflow-hidden bg-slate-900">
                        <img
                          src={image.url}
                          alt={image.caption}
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                          loading="lazy"
                          decoding="async"
                          style={image.height ? `height: ${image.height}` : ''}
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
                      </div>
                      <div class="p-4 text-center">
                        <p class="text-sm font-medium text-gray-300" data-image-caption={step.id}>
                          {image.caption}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- Navigation Buttons -->
                <div class="flex items-center justify-between gap-4 pt-6 border-t border-white/10">
                  <button
                    type="button"
                    class={`nav-button-prev flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition-all duration-200 hover:border-brand-400 hover:bg-brand-500/20 disabled:opacity-50 disabled:cursor-not-allowed ${
                      index === 0 ? 'opacity-50 cursor-not-allowed' : ''
                    }`}
                    data-step-index={index}
                    disabled={index === 0}
                  >
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    <span data-i18n-prev>上一个</span>
                  </button>
                  
                  <div class="text-sm text-gray-400">
                    <span data-step-counter>{index + 1}</span> / <span data-total-steps>{processSteps.length}</span>
                  </div>
                  
                  <button
                    type="button"
                    class={`nav-button-next flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition-all duration-200 hover:border-brand-400 hover:bg-brand-500/20 disabled:opacity-50 disabled:cursor-not-allowed ${
                      index === processSteps.length - 1 ? 'opacity-50 cursor-not-allowed' : ''
                    }`}
                    data-step-index={index}
                    disabled={index === processSteps.length - 1}
                  >
                    <span data-i18n-next>下一个</span>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
              </div>
            </section>
          ))}
        </main>
      </div>
    </section>
  </div>
</Layout>

<script define:vars={{ translations, processSteps }}>
  // Get language from storage or URL
  function getLanguage() {
    if (typeof window === 'undefined') return 'zh';
    const stored = localStorage.getItem('language');
    const urlLang = new URLSearchParams(window.location.search).get('lang');
    return (urlLang === 'en' || urlLang === 'zh') ? urlLang : (stored === 'en' || stored === 'zh') ? stored : 'zh';
  }

  // Update page texts based on language
  function updatePageTexts(lang) {
    const t = translations[lang];
    if (!t) return;

    // Update elements with data-i18n attribute
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value = t;
        for (const k of keys) {
          value = value?.[k];
        }
        if (value && typeof value === 'string') {
          el.textContent = value;
        }
      }
    });

    // Update navigation button texts
    document.querySelectorAll('[data-i18n-prev]').forEach((el) => {
      el.textContent = lang === 'en' ? 'Previous' : '上一个';
    });
    document.querySelectorAll('[data-i18n-next]').forEach((el) => {
      el.textContent = lang === 'en' ? 'Next' : '下一个';
    });

    // Update step names
    document.querySelectorAll('[data-step-name]').forEach((el) => {
      const stepId = el.getAttribute('data-step-name');
      const step = processSteps.find(s => s.id === stepId);
      if (step) {
        const name = lang === 'en' ? step.nameEn : step.name;
        el.textContent = `${stepId}. ${name}`;
      }
    });

    // Update step titles
    document.querySelectorAll('[data-step-title]').forEach((el) => {
      const stepId = el.getAttribute('data-step-title');
      const step = processSteps.find(s => s.id === stepId);
      if (step) {
        el.textContent = lang === 'en' ? step.titleEn : step.title;
      }
    });

    // Update step descriptions
    document.querySelectorAll('[data-step-description]').forEach((el) => {
      const stepId = el.getAttribute('data-step-description');
      const step = processSteps.find(s => s.id === stepId);
      if (step) {
        el.textContent = lang === 'en' ? step.descriptionEn : step.description;
      }
    });

    // Update image captions
    document.querySelectorAll('[data-image-caption]').forEach((el) => {
      const stepId = el.getAttribute('data-image-caption');
      const step = processSteps.find(s => s.id === stepId);
      if (step) {
        const imageIndex = Array.from(el.parentElement.parentElement.parentElement.children).indexOf(el.parentElement.parentElement);
        const image = step.images[imageIndex];
        if (image) {
          el.textContent = lang === 'en' ? image.captionEn : image.caption;
        }
      }
    });
  }

  // Function to switch to a specific step
  function switchToStep(stepIndex) {
    const timelineItems = document.querySelectorAll('.timeline-item');
    const contentSections = document.querySelectorAll('.content-section');

    // Update timeline
    timelineItems.forEach((item, index) => {
      item.classList.toggle('active', index === stepIndex);
      const marker = item.querySelector('.timeline-marker');
      const text = item.querySelector('.timeline-text');
      if (marker && text) {
        if (index === stepIndex) {
          marker.classList.remove('border-white/30', 'bg-white/5');
          marker.classList.add('border-brand-500', 'bg-brand-500', 'shadow-lg', 'shadow-brand-500/50');
          text.classList.remove('text-gray-400');
          text.classList.add('bg-brand-500', 'text-white');
        } else {
          marker.classList.remove('border-brand-500', 'bg-brand-500', 'shadow-lg', 'shadow-brand-500/50');
          marker.classList.add('border-white/30', 'bg-white/5');
          text.classList.remove('bg-brand-500', 'text-white');
          text.classList.add('text-gray-400');
        }
      }
    });

    // Update content sections
    contentSections.forEach((section, index) => {
      if (index === stepIndex) {
        section.classList.remove('hidden');
        section.classList.add('active');
      } else {
        section.classList.remove('active');
        section.classList.add('hidden');
      }
    });

    // Update navigation buttons
    updateNavigationButtons(stepIndex);

    // Scroll to top of content area (not to section, to avoid jumping)
    const contentArea = document.querySelector('main');
    if (contentArea) {
      contentArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Update navigation buttons state
  function updateNavigationButtons(currentIndex) {
    const prevButtons = document.querySelectorAll('.nav-button-prev');
    const nextButtons = document.querySelectorAll('.nav-button-next');

    prevButtons.forEach((btn) => {
      const stepIndex = parseInt(btn.getAttribute('data-step-index'));
      if (stepIndex === currentIndex) {
        btn.disabled = currentIndex === 0;
        btn.classList.toggle('opacity-50', currentIndex === 0);
        btn.classList.toggle('cursor-not-allowed', currentIndex === 0);
      }
    });

    nextButtons.forEach((btn) => {
      const stepIndex = parseInt(btn.getAttribute('data-step-index'));
      if (stepIndex === currentIndex) {
        btn.disabled = currentIndex === processSteps.length - 1;
        btn.classList.toggle('opacity-50', currentIndex === processSteps.length - 1);
        btn.classList.toggle('cursor-not-allowed', currentIndex === processSteps.length - 1);
      }
    });
  }

  // Timeline navigation functionality
  function initTimelineNavigation() {
    const timelineItems = document.querySelectorAll('.timeline-item');

    timelineItems.forEach((item) => {
      item.addEventListener('click', function() {
        const stepIndex = parseInt(this.getAttribute('data-step-index'));
        switchToStep(stepIndex);
      });
    });
  }

  // Navigation buttons functionality
  function initNavigationButtons() {
    // Previous buttons
    document.querySelectorAll('.nav-button-prev').forEach((btn) => {
      btn.addEventListener('click', function() {
        const currentIndex = parseInt(this.getAttribute('data-step-index'));
        if (currentIndex > 0) {
          switchToStep(currentIndex - 1);
        }
      });
    });

    // Next buttons
    document.querySelectorAll('.nav-button-next').forEach((btn) => {
      btn.addEventListener('click', function() {
        const currentIndex = parseInt(this.getAttribute('data-step-index'));
        if (currentIndex < processSteps.length - 1) {
          switchToStep(currentIndex + 1);
        }
      });
    });
  }

  // Initialize on page load
  function initPage() {
    const lang = getLanguage();
    updatePageTexts(lang);
    initTimelineNavigation();
    initNavigationButtons();
    updateNavigationButtons(0); // Initialize buttons for first step
  }

  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', initPage);

    // Listen for language change events
    window.addEventListener('languagechange', (event) => {
      if (event.detail?.lang) {
        updatePageTexts(event.detail.lang);
      }
    });

    window.addEventListener('storage', (event) => {
      if (event.key === 'language') {
        const newLang = event.newValue || 'zh';
        updatePageTexts(newLang);
      }
    });

    // Make updatePageTexts globally accessible
    window.updatePageTexts = updatePageTexts;
  }
</script>

