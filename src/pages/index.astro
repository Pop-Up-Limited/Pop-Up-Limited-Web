    <section class="mx-auto mb-24 w-full max-w-6xl rounded-3xl border border-brand-500/20 bg-brand-500/10 px-6 py-12 text-center shadow-brand-md md:px-12">
      <h2 class="text-3xl font-semibold text-brand-700 md:text-4xl dark:text-brand-100" data-i18n="cta.title"></h2>
      <p class="mt-4 text-base text-brand-800/80 dark:text-brand-200/80" data-i18n="cta.subtitle"></p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a class="btn-primary" href="/support" data-i18n="cta.support"></a>
        <a class="btn-secondary" href="/services" data-i18n="cta.services"></a>
      </div>
    </section>
