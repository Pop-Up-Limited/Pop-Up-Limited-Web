---
import Layout from '../layouts/Layout.astro';
import { HERO, WHY_US, COMPANY_NAME, COMPANY_TAGLINE, DEFAULT_DESCRIPTION } from '../config/site';
import { translations } from '../i18n/translations';
import { cases } from '../data/cases';

// 按设计分级分组
const premiumCases = cases.filter(c => c.designTier === 'premium');
const premiumPlusCases = cases.filter(c => c.designTier === 'premium-plus');
---

<Layout title={`${COMPANY_NAME} · ${COMPANY_TAGLINE}`} description={DEFAULT_DESCRIPTION}>
  <div class="relative overflow-hidden">
    <section class="relative mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 pb-24 pt-16 md:px-6 md:pt-24">
      <div class="absolute inset-x-0 -top-32 -z-10 h-[420px] bg-gradient-to-b from-brand-500/25 to-transparent blur-3xl"></div>
      <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] md:items-center">
        <div class="space-y-6">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-brand-600" data-i18n="hero.badge">
            Building innovative mobile applications
          </span>
          <h1 class="text-4xl font-semibold leading-tight text-foreground md:text-5xl lg:text-6xl dark:text-foreground-dark" data-i18n="hero.title">
            {HERO.title}
          </h1>
          <p class="max-w-xl text-lg text-foreground-muted dark:text-slate-300" data-i18n="hero.subtitle">
            {HERO.subtitle}
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a class="btn-primary" href={HERO.primaryCta.href} data-i18n="hero.primaryCta">
              {HERO.primaryCta.label}
            </a>
            <a class="btn-secondary" href={HERO.secondaryCta.href} data-i18n="hero.secondaryCta">
              {HERO.secondaryCta.label}
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="card-surface relative overflow-hidden">
            <div class="space-y-4">
              <h2 class="text-lg font-semibold text-foreground dark:text-foreground-dark" data-i18n="hero.features.title">
                快速启动，适应性强的工作流程
              </h2>
              <p class="text-sm leading-relaxed text-foreground-muted dark:text-slate-300" data-i18n="hero.features.description">
                Pop Up Limited 结合 AI 辅助和人工监督，让营销和产品团队能够在几小时内将想法变为现实，而不是几周。
              </p>
              <ul class="grid gap-3 text-sm text-foreground-muted dark:text-slate-300">
                <li class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </span>
                  <span data-i18n="hero.features.item1">安全合规保障，适用于敏感行业</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </span>
                  <span data-i18n="hero.features.item2">零维护的创意流程</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                  </span>
                  <span data-i18n="hero.features.item3">连接产品、设计和支持的洞察力</span>
                </li>
              </ul>
            </div>
            <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-white/0 via-white/10 to-brand-500/10 dark:from-white/0 dark:via-white/5 dark:to-brand-500/10"></div>
          </div>
        </div>
      </div>
    </section>


    <section class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-4 pb-24 md:px-6 md:flex-row md:items-center">
      <div class="md:w-1/2">
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark" data-i18n="about.title">
          About {COMPANY_NAME}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-foreground-muted dark:text-slate-300" data-i18n="about.description1">
          We are a product studio specializing in UI/UX design, product management, iOS development, and digital marketing. Our mission is to transform concepts into reality with precision and creativity.
        </p>
        <p class="mt-4 text-base leading-relaxed text-foreground-muted dark:text-slate-300" data-i18n="about.description2">
          Pop Up Limited provides professional web development services. We bring your vision to life with scalable design and data-driven solutions.
        </p>
      </div>

      <div class="md:w-1/2">
        <div class="grid gap-4 rounded-2xl border border-brand-500/20 bg-brand-500/10 p-6 shadow-brand-sm dark:border-brand-500/30">
          <h3 class="text-xl font-semibold text-brand-700 dark:text-brand-200" data-i18n="about.quote">
            "I specialize in transforming concepts into realistic products. Whether it's software or games, my portfolio is designed to mature the product."
          </h3>
          <p class="text-sm text-brand-800/80 dark:text-brand-100/80" data-i18n="about.quoteAuthor">
            — Jinyi (Bruce) Li, Founder
          </p>
        </div>
      </div>
    </section>

    <!-- Portfolio Showcase Section -->
    <section class="mx-auto w-full max-w-6xl px-4 pb-24 md:px-6">
      <div class="mb-10 flex flex-col gap-3">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-500" data-i18n="portfolio.badge">
          Portfolio
        </span>
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark" data-i18n="portfolio.title">
          Our Work in Action
        </h2>
        <p class="max-w-2xl text-sm text-foreground-muted dark:text-slate-300" data-i18n="portfolio.subtitle">
          Explore our portfolio of successful projects, from university websites to innovative web applications and data visualizations.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- 顶级设计案例 -->
        {premiumPlusCases.map((caseItem) => (
          <a
            href={caseItem.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block overflow-hidden rounded-xl border-2 border-purple-500/30 bg-white transition-all duration-300 hover:border-purple-500 hover:shadow-lg dark:border-purple-500/50 dark:bg-slate-900"
          >
            <div class="absolute top-3 right-3 z-10">
              <span class="rounded-full bg-purple-500 px-3 py-1 text-xs font-semibold text-white" data-i18n="portfolio.premiumDesign">
                顶级设计
              </span>
            </div>
            <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-800">
              <img
                src={caseItem.image}
                alt={caseItem.name}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <span class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white" data-i18n="cases.visitSite">
                  访问网站
                </span>
              </div>
            </div>
            <div class="p-4">
              <h3 class="mb-1 text-lg font-semibold text-foreground dark:text-foreground-dark">{caseItem.name}</h3>
              <p class="text-sm text-foreground-muted dark:text-slate-300">{caseItem.description}</p>
            </div>
          </a>
        ))}

        <!-- 优质设计案例 -->
        {premiumCases.map((caseItem) => (
          <a
            href={caseItem.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block overflow-hidden rounded-xl border-2 border-slate-200 bg-white transition-all duration-300 hover:border-brand-500 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
          >
            <div class="absolute top-3 right-3 z-10">
              <span class="rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white" data-i18n="portfolio.qualityDesign">
                优质设计
              </span>
            </div>
            <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-800">
              <img
                src={caseItem.image}
                alt={caseItem.name}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <span class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white" data-i18n="cases.visitSite">
                  访问网站
                </span>
              </div>
            </div>
            <div class="p-4">
              <h3 class="mb-1 text-lg font-semibold text-foreground dark:text-foreground-dark">{caseItem.name}</h3>
              <p class="text-sm text-foreground-muted dark:text-slate-300">{caseItem.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/cases" class="btn-secondary" data-i18n="portfolio.viewMore">
          查看更多案例
        </a>
      </div>
    </section>

    <!-- 数据可视化 Section -->
    <section class="mx-auto w-full max-w-6xl px-4 pb-24 md:px-6">
      <div class="mb-10 flex flex-col gap-3">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-500" data-i18n="stats.badge">
          数据统计
        </span>
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark" data-i18n="stats.title">
          我们的成果
        </h2>
        <p class="max-w-2xl text-sm text-foreground-muted dark:text-slate-300" data-i18n="stats.subtitle">
          用数据说话，展示我们的专业能力和服务成果
        </p>
      </div>

      <!-- 核心指标 -->
      <div class="mb-12 grid gap-6 md:grid-cols-4">
        <div class="card-surface flex flex-col items-center justify-center p-6 text-center">
          <div class="mb-3 text-4xl font-bold text-brand-600 dark:text-brand-400">2000+</div>
          <div class="text-sm font-semibold text-foreground-muted dark:text-slate-400" data-i18n="stats.cases">服务经验</div>
        </div>
        <div class="card-surface flex flex-col items-center justify-center p-6 text-center">
          <div class="mb-3 text-4xl font-bold text-brand-600 dark:text-brand-400">98%</div>
          <div class="text-sm font-semibold text-foreground-muted dark:text-slate-400" data-i18n="stats.satisfaction">客户满意度</div>
        </div>
        <div class="card-surface flex flex-col items-center justify-center p-6 text-center">
          <div class="mb-3 text-4xl font-bold text-brand-600 dark:text-brand-400">
            <span>12</span>
            <span class="text-2xl" data-i18n="stats.charts.days">天</span>
          </div>
          <div class="text-sm font-semibold text-foreground-muted dark:text-slate-400" data-i18n="stats.delivery">平均交付周期</div>
        </div>
        <div class="card-surface flex flex-col items-center justify-center p-6 text-center">
          <div class="mb-3 text-4xl font-bold text-brand-600 dark:text-brand-400">
            <span>48</span>
            <span class="text-2xl" data-i18n="stats.charts.hours">小时</span>
          </div>
          <div class="text-sm font-semibold text-foreground-muted dark:text-slate-400" data-i18n="stats.support">平均响应时间</div>
        </div>
      </div>

      <!-- 详细数据可视化 -->
      <div class="grid gap-6 md:grid-cols-2">
        <!-- 设计分级分布 -->
        <div class="card-surface p-6">
          <h3 class="mb-6 text-lg font-semibold text-foreground dark:text-foreground-dark" data-i18n="stats.charts.designTier">
            设计分级分布
          </h3>
          <div class="h-64">
            <canvas id="design-tier-chart"></canvas>
          </div>
        </div>

        <!-- 服务类型分布 -->
        <div class="card-surface p-6">
          <h3 class="mb-6 text-lg font-semibold text-foreground dark:text-foreground-dark" data-i18n="stats.charts.serviceType">
            服务类型分布
          </h3>
          <div class="h-64">
            <canvas id="service-type-chart"></canvas>
          </div>
        </div>

        <!-- 交付周期统计 -->
        <div class="card-surface p-6">
          <h3 class="mb-6 text-lg font-semibold text-foreground dark:text-foreground-dark" data-i18n="stats.charts.delivery">
            交付周期统计
          </h3>
          <div class="h-64">
            <canvas id="delivery-cycle-chart"></canvas>
          </div>
          <div class="mt-4 text-center">
            <div class="text-xs font-medium text-foreground-muted dark:text-slate-400" data-i18n="stats.charts.avgDelivery">平均交付周期</div>
            <div class="text-2xl font-bold text-brand-600 dark:text-brand-400">
              <span>12.5</span>
              <span data-i18n="stats.charts.days">天</span>
            </div>
          </div>
        </div>

        <!-- 客户反馈评分 -->
        <div class="card-surface p-6">
          <h3 class="mb-6 text-lg font-semibold text-foreground dark:text-foreground-dark" data-i18n="stats.charts.feedback">
            客户反馈评分
          </h3>
          <div class="space-y-4">
            <div>
              <div class="mb-2 flex items-center justify-between text-sm">
                <span class="font-medium text-foreground-muted dark:text-slate-300" data-i18n="stats.charts.designQuality">设计质量</span>
                <span class="font-semibold text-brand-600 dark:text-brand-400">4.8</span>
              </div>
              <div class="flex gap-1">
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-slate-300 dark:text-slate-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              </div>
            </div>
            <div>
              <div class="mb-2 flex items-center justify-between text-sm">
                <span class="font-medium text-foreground-muted dark:text-slate-300" data-i18n="stats.charts.developmentEfficiency">开发效率</span>
                <span class="font-semibold text-brand-600 dark:text-brand-400">4.9</span>
              </div>
              <div class="flex gap-1">
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <svg class="h-5 w-5 text-slate-300 dark:text-slate-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
