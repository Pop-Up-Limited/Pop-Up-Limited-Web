---
import Layout from '../layouts/Layout.astro';
import { HERO, WHY_US, COMPANY_NAME, COMPANY_TAGLINE, DEFAULT_DESCRIPTION } from '../config/site';
import { products } from '../data/products';
import ProductCard from '../components/ProductCard.astro';
---

<Layout title={`${COMPANY_NAME} · ${COMPANY_TAGLINE}`} description={DEFAULT_DESCRIPTION}>
  <div class="relative overflow-hidden">
    <section class="relative mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 pb-24 pt-16 md:px-6 md:pt-24">
      <div class="absolute inset-x-0 -top-32 -z-10 h-[420px] bg-gradient-to-b from-brand-500/25 to-transparent blur-3xl"></div>
      <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] md:items-center">
        <div class="space-y-6">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-brand-600">
            Building innovative mobile applications
          </span>
          <h1 class="text-4xl font-semibold leading-tight text-foreground md:text-5xl lg:text-6xl dark:text-foreground-dark">
            {HERO.title}
          </h1>
          <p class="max-w-xl text-lg text-foreground-muted dark:text-slate-300">
            {HERO.subtitle}
          </p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a class="btn-primary" href={HERO.primaryCta.href}>
              {HERO.primaryCta.label}
            </a>
            <a class="btn-secondary" href={HERO.secondaryCta.href}>
              {HERO.secondaryCta.label}
            </a>
          </div>
        </div>

        <div class="relative">
          <div class="card-surface relative overflow-hidden">
            <div class="space-y-4">
              <h2 class="text-lg font-semibold text-foreground dark:text-foreground-dark">
                Launch faster with adaptive workflows
              </h2>
              <p class="text-sm leading-relaxed text-foreground-muted dark:text-slate-300">
                Pop Up Limited combines AI copilots and human oversight so marketing and product teams can make ideas tangible within hours, not weeks. {/* TODO: refine messaging */}
              </p>
              <ul class="grid gap-3 text-sm text-foreground-muted dark:text-slate-300">
                <li class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  </span>
                  <span>Secure compliance guardrails for sensitive industries</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </span>
                  <span>Zero-maintenance creative pipelines</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-500/10 text-brand-600">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                  </span>
                  <span>Insights that bridge product, design, and support</span>
                </li>
              </ul>
            </div>
            <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-white/0 via-white/10 to-brand-500/10 dark:from-white/0 dark:via-white/5 dark:to-brand-500/10"></div>
          </div>
        </div>
      </div>
    </section>

    <section id="products" class="mx-auto w-full max-w-6xl px-4 pb-24 md:px-6">
      <div class="mb-10 flex flex-col gap-3">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-500">
          Products
        </span>
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark">
          Explore our toolkit
        </h2>
            <p class="max-w-2xl text-sm text-foreground-muted dark:text-slate-300">
              From Phoro's AI image generation to our professional web development services, we build products that amplify your team's creativity.
            </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </section>

    <section class="mx-auto flex w-full max-w-6xl flex-col gap-12 px-4 pb-24 md:px-6 md:flex-row md:items-center">
      <div class="md:w-1/2">
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark">
          About {COMPANY_NAME}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-foreground-muted dark:text-slate-300">
          We are a product studio specializing in UI/UX design, product management, iOS development, and digital marketing. Our mission is to transform concepts into reality with precision and creativity.
        </p>
        <p class="mt-4 text-base leading-relaxed text-foreground-muted dark:text-slate-300">
          Pop Up Limited has developed Phoro for AI-powered image generation and provides professional web development services. We bring your vision to life with scalable design and data-driven solutions.
        </p>
      </div>

      <div class="md:w-1/2">
        <div class="grid gap-4 rounded-2xl border border-brand-500/20 bg-brand-500/10 p-6 shadow-brand-sm dark:border-brand-500/30">
          <h3 class="text-xl font-semibold text-brand-700 dark:text-brand-200">
            "I specialize in transforming concepts into realistic products. Whether it's software or games, my portfolio is designed to mature the product."
          </h3>
          <p class="text-sm text-brand-800/80 dark:text-brand-100/80">
            — Jinyi (Bruce) Li, Founder
          </p>
        </div>
      </div>
    </section>

    <!-- Portfolio Showcase Section -->
    <section class="mx-auto w-full max-w-6xl px-4 pb-24 md:px-6">
      <div class="mb-10 flex flex-col gap-3">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-500">
          Portfolio
        </span>
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark">
          Our Work in Action
        </h2>
        <p class="max-w-2xl text-sm text-foreground-muted dark:text-slate-300">
          Explore our portfolio of successful projects, from university websites to innovative web applications and data visualizations.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Case Preview Cards -->
        <a
          href="https://mapier.ai/"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-xl border-2 border-slate-200 bg-white transition-all duration-300 hover:border-brand-500 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img
              src="/images/projects/mapier.png"
              alt="Mapier.ai"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white">
                访问网站 →
              </span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="mb-1 text-lg font-semibold text-foreground dark:text-foreground-dark">Mapier.ai</h3>
            <p class="text-sm text-foreground-muted dark:text-slate-300">AI-powered mapping platform</p>
          </div>
        </a>

        <a
          href="https://popup.limited/"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-xl border-2 border-slate-200 bg-white transition-all duration-300 hover:border-brand-500 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img
              src="/images/projects/popup-limited.png"
              alt="Popup.limited"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white">
                访问网站 →
              </span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="mb-1 text-lg font-semibold text-foreground dark:text-foreground-dark">Popup.limited</h3>
            <p class="text-sm text-foreground-muted dark:text-slate-300">Creative agency portfolio</p>
          </div>
        </a>

        <a
          href="https://www.ljystudio.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-xl border-2 border-slate-200 bg-white transition-all duration-300 hover:border-brand-500 hover:shadow-lg dark:border-slate-700 dark:bg-slate-900"
        >
          <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img
              src="/images/projects/ljystudio.png"
              alt="LJY Studio"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:opacity-100"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <span class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white">
                访问网站 →
              </span>
            </div>
          </div>
          <div class="p-4">
            <h3 class="mb-1 text-lg font-semibold text-foreground dark:text-foreground-dark">LJY Studio</h3>
            <p class="text-sm text-foreground-muted dark:text-slate-300">Design portfolio showcase</p>
          </div>
        </a>
      </div>

      <div class="mt-8 text-center">
        <a href="/cases" class="btn-secondary">
          查看更多案例 →
        </a>
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-4 pb-24 md:px-6">
      <div class="mb-10 flex flex-col gap-3">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-500">
          Why us
        </span>
        <h2 class="text-3xl font-semibold text-foreground md:text-4xl dark:text-foreground-dark">
          {WHY_US.headline}
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {WHY_US.points.map((point, index) => (
          <div class="card-surface flex flex-col gap-4 p-6 transition-all duration-300 hover:shadow-lg">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-500/10 text-brand-600">
              {index === 0 && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {index === 1 && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
              )}
              {index === 2 && (
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-foreground dark:text-foreground-dark">
              {point.title}
            </h3>
            <p class="text-sm leading-relaxed text-foreground-muted dark:text-slate-300">
              {point.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto mb-24 w-full max-w-6xl rounded-3xl border border-brand-500/20 bg-brand-500/10 px-6 py-12 text-center shadow-brand-md md:px-12">
      <h2 class="text-3xl font-semibold text-brand-700 md:text-4xl dark:text-brand-100">
        Ready to co-create with Pop Up Limited?
      </h2>
      <p class="mt-4 text-base text-brand-800/80 dark:text-brand-200/80">
        Partner with us to develop your mobile applications, design user experiences, or launch your digital products. Let's create something extraordinary together!
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a class="btn-primary" href="/support">
          Visit Support Center
        </a>
        <a class="btn-secondary" href="/phoro/terms-and-conditions">
          Review Phoro Terms
        </a>
      </div>
    </section>
  </div>
</Layout>
