---
import Layout from '../layouts/Layout.astro';
import { HERO, WHY_US, COMPANY_NAME, COMPANY_TAGLINE, DEFAULT_DESCRIPTION } from '../config/site';
import { translations } from '../i18n/translations';
import { cases } from '../data/cases';
import Danmaku from '../components/Danmaku.astro';
import SupportButton from '../components/SupportButton.jsx';
import MouseFollower from '../components/MouseFollower.astro';
import SaturnBackground from '../components/SaturnBackground.astro';

// 按设计分级分组
const premiumCases = cases.filter(c => c.designTier === 'premium');
const premiumPlusCases = cases.filter(c => c.designTier === 'premium-plus');
// Combine cases for the stacking list, prioritize premium plus
const allCases = [...premiumPlusCases, ...premiumCases].slice(0, 5); 

const heroDefaults = translations.zh.hero;
const heroFeatureDefaults = heroDefaults.features;
---

<Layout title={`${COMPANY_NAME} · ${COMPANY_TAGLINE}`} description={DEFAULT_DESCRIPTION}>
  <MouseFollower />
  <SaturnBackground />
  <div class="relative">
    
    <!-- HERO SECTION -->
    <section class="relative min-h-[90vh] w-full flex items-center overflow-hidden">
      <!-- Background gradient overlay -->
      <div class="absolute inset-x-0 -top-32 -z-10 h-[420px] bg-gradient-to-b from-brand-500/15 to-transparent blur-3xl"></div>

      <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 md:px-6 pointer-events-none">
        <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] md:items-center">
          <div class="space-y-6 pointer-events-auto p-4 md:p-0">
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-400/30 bg-brand-500/20 px-4 py-2 text-xs font-semibold uppercase tracking-wide text-brand-300" data-i18n="hero.badge">
            {heroDefaults.badge}
          </span>
            <h1 class="text-4xl font-bold leading-tight text-white md:text-6xl lg:text-7xl drop-shadow-lg" data-i18n="hero.title">
            {heroDefaults.title}
          </h1>
            <p class="max-w-md text-lg text-gray-300 md:text-xl drop-shadow-md" data-i18n="hero.subtitle">
            {heroDefaults.subtitle}
          </p>
            <div class="flex flex-col gap-4 sm:flex-row">
              <!-- Support Button with WeChat Modal -->
              <SupportButton 
                client:visible 
                text={heroDefaults.primaryCta} 
                className="btn-primary transform transition hover:scale-105 cursor-pointer" 
              />
              <a class="btn-secondary transform transition hover:scale-105 cursor-pointer" href={HERO.secondaryCta.href} data-i18n="hero.secondaryCta">
              {heroDefaults.secondaryCta}
            </a>
          </div>
        </div>

          <!-- Right side spacer -->
          <div class="hidden md:block relative h-[500px] pointer-events-auto"></div>
        </div>
      </div>
    </section>

    <!-- DANMAKU SECTION -->
    <section class="relative z-20 border-y border-white/10 bg-black/50 backdrop-blur-sm">
      <Danmaku />
    </section>

    <!-- PORTFOLIO STACKING CARDS SECTION -->
    <section class="relative z-30 py-24 bg-gradient-to-b from-transparent via-black/50 to-black/80">
        <!-- Title that scrolls with content -->
        <div class="mx-auto w-full max-w-6xl px-4 md:px-6 mb-24 text-center">
            <span class="text-sm font-semibold uppercase tracking-wide text-brand-400" data-i18n="portfolio.badge"></span>
            <h2 class="text-4xl font-bold text-white md:text-5xl mt-2" data-i18n="portfolio.title"></h2>
            <p class="max-w-2xl mx-auto mt-4 text-lg text-gray-400" data-i18n="portfolio.subtitle"></p>
        </div>

        <div class="mx-auto w-full max-w-5xl px-4 md:px-6 pb-24">
            <div class="flex flex-col gap-32">
                {allCases.map((caseItem, index) => (
                    <div class="sticky w-full" style={`z-index: ${index + 1}; top: 120px;`} data-card-index={index}>
          <a
            href={caseItem.url}
            target="_blank"
            rel="noopener noreferrer"
                            class="group relative block overflow-hidden rounded-3xl border border-white/20 bg-gradient-to-br from-white/10 to-white/5 backdrop-blur-md shadow-2xl shadow-purple-900/30 card-stack-item"
          >
                            <div class="grid md:grid-cols-2 gap-0 min-h-[450px]">
                                <div class="relative h-full min-h-[300px] overflow-hidden bg-black/40 order-2 md:order-1">
              <img
                src={caseItem.image}
                alt={caseItem.name}
                                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
                                    {caseItem.designTier === 'premium-plus' && (
                                        <div class="absolute top-4 left-4 z-10">
                                             <span class="rounded-full bg-purple-500/90 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-white shadow-lg">
                                                Top Tier
                                             </span>
                                        </div>
                                    )}
                                </div>
                                <div class="p-8 md:p-12 flex flex-col justify-center order-1 md:order-2">
                                    <h3 class="mb-4 text-3xl font-bold text-white">{caseItem.name}</h3>
                                    <p class="text-lg text-gray-400 leading-relaxed mb-8">{caseItem.description}</p>
                                    <div>
                                        <span class="inline-flex items-center gap-2 text-brand-400 font-semibold group-hover:gap-3 transition-all">
                                            <span data-i18n="cases.visitSite">Visit Website</span>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                        </span>
              </div>
            </div>
            </div>
          </a>
                    </div>
                ))}
            </div>
            
            <div class="mt-24 text-center relative z-50">
               <a href="/cases" class="btn-secondary px-8 py-3 rounded-full text-lg hover:shadow-lg transition-all" data-i18n="portfolio.viewMore"></a>
            </div>
        </div>
    </section>

    <!-- About / Services / Why Us (Standard Flow) -->
    <section class="relative z-40 py-24 bg-black/80">
        <div class="mx-auto w-full max-w-6xl px-4 md:px-6">
           <div class="flex flex-col md:flex-row gap-12 items-center mb-16">
             <div class="md:w-1/2">
               <h2 class="text-3xl font-bold text-white md:text-5xl mb-6" data-i18n="about.title"></h2>
               <p class="text-lg leading-relaxed text-gray-400 mb-4" data-i18n="about.description1"></p>
               <p class="text-lg leading-relaxed text-gray-400" data-i18n="about.description2"></p>
             </div>
             <div class="md:w-1/2">
               <div class="relative overflow-hidden rounded-2xl border border-brand-400/20 bg-brand-500/10 p-8 backdrop-blur-sm">
                  <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-brand-500/30 blur-2xl"></div>
                  <h3 class="text-2xl font-bold text-brand-300 relative z-10" data-i18n="about.quote"></h3>
                  <p class="mt-4 text-base font-medium text-brand-200/60 relative z-10" data-i18n="about.quoteAuthor"></p>
               </div>
             </div>
           </div>

          <div class="mb-10">
             <span class="text-sm font-semibold uppercase tracking-wide text-brand-400" data-i18n="whyUs.badge"></span>
             <h2 class="text-3xl font-bold text-white md:text-4xl mt-2" data-i18n="whyUs.title"></h2>
          </div>

          <div class="grid gap-6 md:grid-cols-3">
            {translations.zh.whyUs.points.map((point, index) => (
              <div class="group card-surface flex flex-col gap-4 p-8 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 bg-gradient-to-br from-white/15 to-white/5 rounded-2xl border border-white/20">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-500/20 text-brand-400 transition-colors group-hover:bg-brand-500 group-hover:text-white">
                  {index === 0 && (
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  )}
                  {index === 1 && (
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                  )}
                  {index === 2 && (
                    <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-bold text-white" data-i18n={`whyUs.points.${index}.title`}></h3>
                <p class="text-base leading-relaxed text-gray-400" data-i18n={`whyUs.points.${index}.description`}></p>
              </div>
        ))}
      </div>
      </div>
    </section>

      <!-- Data Visualization Section -->
      <section class="relative z-50 py-24 bg-black/90">
        <div class="mx-auto w-full max-w-6xl px-4 md:px-6">
      <div class="mb-10 flex flex-col gap-3">
        <span class="text-sm font-semibold uppercase tracking-wide text-brand-400" data-i18n="stats.badge"></span>
            <h2 class="text-4xl font-bold text-white md:text-5xl" data-i18n="stats.title"></h2>
            <p class="max-w-2xl text-lg text-gray-400" data-i18n="stats.subtitle"></p>
      </div>

      <!-- 核心指标 -->
      <div class="mb-12 grid gap-6 md:grid-cols-4">
            <div class="card-surface flex flex-col items-center justify-center p-8 text-center rounded-2xl hover:shadow-xl transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/50">
              <div class="mb-3 text-5xl font-bold text-brand-400">2000+</div>
              <div class="text-sm font-bold text-gray-300 uppercase tracking-wider" data-i18n="stats.cases"></div>
            </div>
            <div class="card-surface flex flex-col items-center justify-center p-8 text-center rounded-2xl hover:shadow-xl transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/50">
              <div class="mb-3 text-5xl font-bold text-brand-400">98%</div>
              <div class="text-sm font-bold text-gray-300 uppercase tracking-wider" data-i18n="stats.satisfaction"></div>
            </div>
            <div class="card-surface flex flex-col items-center justify-center p-8 text-center rounded-2xl hover:shadow-xl transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/50">
              <div class="mb-3 text-5xl font-bold text-brand-400">3天</div>
              <div class="text-sm font-bold text-gray-300 uppercase tracking-wider" data-i18n="stats.delivery"></div>
            </div>
            <div class="card-surface flex flex-col items-center justify-center p-8 text-center rounded-2xl hover:shadow-xl transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/50">
              <div class="mb-3 text-5xl font-bold text-brand-400">6小时</div>
              <div class="text-sm font-bold text-gray-300 uppercase tracking-wider" data-i18n="stats.support"></div>
            </div>
      </div>

      <!-- 详细数据可视化 -->
      <div class="grid gap-6 md:grid-cols-2">
        <!-- 设计分级分布 -->
            <div class="card-surface p-6 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/30">
          <h3 class="mb-6 text-lg font-semibold text-white" data-i18n="stats.charts.designTier"></h3>
          <div class="h-64">
            <canvas id="design-tier-chart"></canvas>
          </div>
        </div>

        <!-- 服务类型分布 -->
            <div class="card-surface p-6 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/30">
          <h3 class="mb-6 text-lg font-semibold text-white" data-i18n="stats.charts.serviceType"></h3>
          <div class="h-64">
            <canvas id="service-type-chart"></canvas>
          </div>
        </div>

        <!-- 交付周期统计 -->
            <div class="card-surface p-6 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/30">
          <h3 class="mb-6 text-lg font-semibold text-white" data-i18n="stats.charts.delivery"></h3>
          <div class="h-64">
            <canvas id="delivery-cycle-chart"></canvas>
          </div>
          <div class="mt-4 text-center">
            <div class="text-xs font-medium text-gray-400" data-i18n="stats.charts.avgDelivery"></div>
            <div class="text-2xl font-bold text-brand-400">
              <span>3</span>
              <span data-i18n="stats.charts.days"></span>
            </div>
          </div>
        </div>

        <!-- 客户反馈评分 -->
            <div class="card-surface p-6 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 bg-gradient-to-br from-white/15 to-white/5 border border-white/20 hover:border-brand-400/30">
          <h3 class="mb-6 text-lg font-semibold text-white" data-i18n="stats.charts.feedback"></h3>
              <div class="space-y-6">
            <div>
                  <div class="mb-3 flex items-center justify-between text-sm">
                <span class="font-medium text-gray-400" data-i18n="stats.charts.designQuality"></span>
                    <span class="font-bold text-brand-400">4.8</span>
              </div>
              <div class="flex gap-1">
                     {[1,2,3,4,5].map((i) => (
                       <svg class={`h-6 w-6 ${i <= 4 ? 'text-yellow-400' : 'text-gray-700'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                     ))}
              </div>
            </div>
            <div>
                  <div class="mb-3 flex items-center justify-between text-sm">
                <span class="font-medium text-gray-400" data-i18n="stats.charts.developmentEfficiency"></span>
                    <span class="font-bold text-brand-400">4.9</span>
              </div>
              <div class="flex gap-1">
                     {[1,2,3,4,5].map((i) => (
                       <svg class={`h-6 w-6 ${i <= 4 ? 'text-yellow-400' : 'text-gray-700'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                     ))}
              </div>
            </div>
            <div>
                  <div class="mb-3 flex items-center justify-between text-sm">
                <span class="font-medium text-gray-400" data-i18n="stats.charts.communication"></span>
                    <span class="font-bold text-brand-400">4.7</span>
              </div>
              <div class="flex gap-1">
                     {[1,2,3,4,5].map((i) => (
                       <svg class={`h-6 w-6 ${i <= 4 ? 'text-yellow-400' : 'text-gray-700'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                     ))}
                  </div>
                </div>
            </div>
          </div>
        </div>
      </div>
    </section>

      <!-- CTA Section (Normal flow) -->
      <section class="relative z-50 mx-auto w-full max-w-6xl px-4 py-24 md:px-6">
        <div class="rounded-3xl border border-brand-400/30 bg-brand-900/30 px-6 py-16 text-center shadow-brand-md md:px-16 backdrop-blur-sm">
          <h2 class="text-3xl font-bold text-white md:text-5xl" data-i18n="cta.title"></h2>
          <p class="mt-6 text-lg text-gray-300 max-w-2xl mx-auto" data-i18n="cta.subtitle"></p>
          <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a class="btn-primary px-8 py-4 text-lg" href="/support" data-i18n="cta.support"></a>
            <a class="btn-secondary px-8 py-4 text-lg" href="/services" data-i18n="cta.services"></a>
          </div>
      </div>
    </section>

      <div class="h-24 bg-transparent"></div>

      </div>
  </div>
</Layout>

<script define:vars={{ translations, premiumCasesCount: premiumCases.length, premiumPlusCasesCount: premiumPlusCases.length }}>
  console.log('Pop Up Limited: v2025.12.05.01 - 3D Saturn Loaded');
  // Chart instances storage (global scope)
  const chartInstances = {};
  
  // Make chartInstances globally accessible
  if (typeof window !== 'undefined') {
    window.chartInstances = chartInstances;
  }

  // Get language from storage or URL
  function getLanguage() {
    const stored = localStorage.getItem('language');
    const urlLang = new URLSearchParams(window.location.search).get('lang');
    return (urlLang === 'en' || urlLang === 'zh') ? urlLang : (stored === 'en' || stored === 'zh') ? stored : 'zh';
  }

  // Function to update charts
  function updateCharts(lang) {
    // Update design tier chart
    if (chartInstances['design-tier']) {
      chartInstances['design-tier'].data.labels = lang === 'zh'
        ? ['顶级设计', '优质设计']
        : ['Top-tier Design', 'Premium Design'];
      chartInstances['design-tier'].update();
    }

    // Update service type chart
    if (chartInstances['service-type']) {
      chartInstances['service-type'].data.labels = lang === 'zh'
        ? ['网站设计', '前端开发', '品牌设计', 'UI/UX设计', '移动端开发']
        : ['Web Design', 'Frontend Dev', 'Brand Design', 'UI/UX Design', 'Mobile Dev'];
      chartInstances['service-type'].data.datasets[0].label = lang === 'zh' ? '占比 (%)' : 'Percentage (%)';
      chartInstances['service-type'].update();
    }

    // Update delivery cycle chart
    if (chartInstances['delivery-cycle']) {
      chartInstances['delivery-cycle'].data.labels = lang === 'zh'
        ? ['1-2 天', '3-4 天', '5-6 天', '7+ 天']
        : ['1-2 days', '3-4 days', '5-6 days', '7+ days'];
      chartInstances['delivery-cycle'].update();
    }
  }
  
  // Make updateCharts globally accessible
  if (typeof window !== 'undefined') {
    window.updateCharts = updateCharts;
  }
  
  // Update all texts on page load
  function updatePageTexts(lang) {
    const t = translations[lang];
    if (!t) return;
    
    // Update all elements with data-i18n attribute (excluding header and footer which have their own handlers)
    document.querySelectorAll('main [data-i18n], [data-i18n]:not(header [data-i18n]):not(footer [data-i18n])').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value = t;
        for (const k of keys) {
          // Handle array indices (e.g., "whyUs.points.0.title")
          if (!isNaN(Number(k))) {
            value = value?.[Number(k)];
          } else {
            value = value?.[k];
          }
        }
        if (value && typeof value === 'string') {
          el.textContent = value;
        }
      }
    });
    
    // Update chart labels if charts are already initialized
    updateCharts(lang);
  }
  
  // Make function globally accessible
  if (typeof window !== 'undefined') {
    window.updatePageTexts = updatePageTexts;
  }
  
  // Initialize charts function
  function initializeCharts() {
    // Check if Chart.js is available (from CDN or import)
    let Chart;
    if (typeof window !== 'undefined' && window.Chart) {
      // Use CDN version
      Chart = window.Chart;
    } else {
      console.error('Chart.js is not available');
      return;
    }

    const currentLang = getLanguage();
    
    // 设计分级分布图表
    const designTierCanvas = document.getElementById('design-tier-chart');
    if (designTierCanvas && designTierCanvas instanceof HTMLCanvasElement) {
      // Destroy existing chart if it exists
      if (chartInstances['design-tier']) {
        chartInstances['design-tier'].destroy();
      }
      
      const ctx = designTierCanvas.getContext('2d');
      if (ctx) {
        const premiumCount = premiumCasesCount;
        const premiumPlusCount = premiumPlusCasesCount;
        
        chartInstances['design-tier'] = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: currentLang === 'zh'
              ? ['顶级设计', '优质设计']
              : ['Top-tier Design', 'Premium Design'],
            datasets: [{
              data: [premiumPlusCount, premiumCount],
              backgroundColor: [
                'rgba(124, 58, 237, 0.85)',
                'rgba(168, 85, 247, 0.85)'
              ],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: {
                    size: 12
                  },
                  color: '#d1d5db'
                }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const label = context.label || '';
                    const value = context.parsed || 0;
                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : '0';
                    return `${label}: ${value} (${percentage}%)`;
                  }
                }
              }
            }
          }
        });
        console.log('Design tier chart initialized');
      }
    } else {
      console.warn('Design tier canvas not found');
    }

    // 服务类型分布图表
    const serviceTypeCanvas = document.getElementById('service-type-chart');
    if (serviceTypeCanvas && serviceTypeCanvas instanceof HTMLCanvasElement) {
      // Destroy existing chart if it exists
      if (chartInstances['service-type']) {
        chartInstances['service-type'].destroy();
      }
      
      const ctx = serviceTypeCanvas.getContext('2d');
      if (ctx) {
        chartInstances['service-type'] = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: currentLang === 'zh' 
              ? ['网站设计', '前端开发', '品牌设计', 'UI/UX设计', '移动端开发']
              : ['Web Design', 'Frontend Dev', 'Brand Design', 'UI/UX Design', 'Mobile Dev'],
            datasets: [{
              label: currentLang === 'zh' ? '占比 (%)' : 'Percentage (%)',
              data: [85, 100, 60, 90, 75],
              backgroundColor: [
                'rgba(62, 29, 130, 0.85)',
                'rgba(124, 58, 237, 0.85)',
                'rgba(147, 51, 234, 0.85)',
                'rgba(168, 85, 247, 0.85)',
                'rgba(192, 132, 252, 0.85)'
              ],
              borderRadius: 8
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return `${context.dataset.label}: ${context.parsed.y}%`;
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  callback: function(value) {
                    return value + '%';
                  },
                  color: '#9ca3af'
                },
                grid: {
                  color: 'rgba(255, 255, 255, 0.1)'
                }
              },
              x: {
                ticks: {
                  color: '#d1d5db'
                },
                grid: {
                  color: 'rgba(255, 255, 255, 0.05)'
                }
              }
            }
          }
        });
        console.log('Service type chart initialized');
      }
    } else {
      console.warn('Service type canvas not found');
    }

    // 交付周期统计图表
    const deliveryCycleCanvas = document.getElementById('delivery-cycle-chart');
    if (deliveryCycleCanvas && deliveryCycleCanvas instanceof HTMLCanvasElement) {
      // Destroy existing chart if it exists
      if (chartInstances['delivery-cycle']) {
        chartInstances['delivery-cycle'].destroy();
      }
      
      const ctx = deliveryCycleCanvas.getContext('2d');
      if (ctx) {
        chartInstances['delivery-cycle'] = new Chart(ctx, {
          type: 'pie',
          data: {
            labels: currentLang === 'zh'
              ? ['1-2 天', '3-4 天', '5-6 天', '7+ 天']
              : ['1-2 days', '3-4 days', '5-6 days', '7+ days'],
            datasets: [{
              data: [50, 40, 8, 2],
              backgroundColor: [
                'rgba(62, 29, 130, 0.85)',
                'rgba(124, 58, 237, 0.85)',
                'rgba(168, 85, 247, 0.85)',
                'rgba(216, 180, 254, 0.85)'
              ],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: {
                    size: 12
                  },
                  color: '#d1d5db'
                }
              }
            }
          }
        });
        console.log('Delivery cycle chart initialized');
      }
    } else {
      console.warn('Delivery cycle canvas not found');
    }
  }

  // Initialize on page load
  function initPage() {
    const lang = getLanguage();
    updatePageTexts(lang);
    
    // Function to try initializing charts
    function tryInitCharts() {
      if (typeof window !== 'undefined' && window.Chart) {
        console.log('Chart.js found, initializing charts...');
        initializeCharts();
        return true;
      }
      return false;
    }
    
    // Try immediately
    if (!tryInitCharts()) {
      // If Chart.js not ready, wait for it
      let retries = 0;
      const maxRetries = 20; // 2 seconds max wait
      const checkInterval = setInterval(() => {
        retries++;
        if (tryInitCharts() || retries >= maxRetries) {
          clearInterval(checkInterval);
          if (retries >= maxRetries && !window.Chart) {
            console.error('Chart.js failed to load after', maxRetries * 100, 'ms');
          }
        }
      }, 100);
    }
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    initPage();
    
    // Listen for language changes from other components
    window.addEventListener('storage', (e) => {
      if (e.key === 'language') {
        const newLang = e.newValue || 'zh';
        updatePageTexts(newLang);
        updateCharts(newLang);
      }
    });
    
    // Listen for language change events from Navbar
    window.addEventListener('languagechange', function(e) {
      const event = e;
      const newLang = event.detail && event.detail.lang;
      if (newLang) {
        updatePageTexts(newLang);
        updateCharts(newLang);
      }
    });
  });

  // Also try to initialize when window loads (fallback)
  if (typeof window !== 'undefined') {
    window.addEventListener('load', () => {
      if (!chartInstances['design-tier'] || 
          !chartInstances['service-type'] || 
          !chartInstances['delivery-cycle']) {
        console.log('Retrying chart initialization on window load');
        if (window.Chart) {
          initializeCharts();
        }
      }
    });
  }

  // Stack Cards - Simple scale effect on scroll (no left-right movement)
  function initStackCards() {
    const cards = document.querySelectorAll('.card-stack-item');
    if (cards.length === 0) return;

    // Update card scales based on scroll position
    function updateCards() {
      cards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        
        const rect = card.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const cardTop = rect.top;
        
        // Calculate how far the card is from the sticky position (top: 120px)
        const stickyTop = 120;
        const distanceFromSticky = cardTop - stickyTop;
        
        // When card is at sticky position, start scaling down
        // Cards that are higher up (stacked behind) should be smaller
        let scale = 1;
        if (distanceFromSticky < 0) {
          // Card is stuck, scale it down based on how far it's been scrolled past
          const progress = Math.min(1, Math.abs(distanceFromSticky) / 300);
          scale = 1 - progress * 0.1; // Scale down to 0.9 at most
        }
        
        // Apply smooth scale transform
        card.style.transform = `scale(${scale})`;
        card.style.transformOrigin = 'center top';
        card.style.transition = 'transform 0.1s ease-out';
      });
    }

    // Update on scroll
    window.addEventListener('scroll', updateCards, { passive: true });
    
    // Initial update
    updateCards();
  }

  // Initialize stack cards animation
  document.addEventListener('DOMContentLoaded', () => {
    initStackCards();
  });

</script>
