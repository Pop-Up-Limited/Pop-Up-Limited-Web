</Layout>

<script define:vars={{ translations, premiumCasesCount: premiumCases.length, premiumPlusCasesCount: premiumPlusCases.length }}>
  // Chart instances storage (global scope)
  const chartInstances = {};
  
  // Make chartInstances globally accessible
  if (typeof window !== 'undefined') {
    window.chartInstances = chartInstances;
  }

  // Get language from storage or URL
  function getLanguage() {
    const stored = localStorage.getItem('language');
    const urlLang = new URLSearchParams(window.location.search).get('lang');
    return (urlLang === 'en' || urlLang === 'zh') ? urlLang : (stored === 'en' || stored === 'zh') ? stored : 'zh';
  }

  // Function to update charts
  function updateCharts(lang) {
    // Update design tier chart
    if (chartInstances['design-tier']) {
      chartInstances['design-tier'].data.labels = lang === 'zh'
        ? ['顶级设计', '优质设计']
        : ['Top-tier Design', 'Premium Design'];
      chartInstances['design-tier'].update();
    }

    // Update service type chart
    if (chartInstances['service-type']) {
      chartInstances['service-type'].data.labels = lang === 'zh'
        ? ['网站设计', '前端开发', '品牌设计', 'UI/UX设计', '移动端开发']
        : ['Web Design', 'Frontend Dev', 'Brand Design', 'UI/UX Design', 'Mobile Dev'];
      chartInstances['service-type'].data.datasets[0].label = lang === 'zh' ? '占比 (%)' : 'Percentage (%)';
      chartInstances['service-type'].update();
    }

    // Update delivery cycle chart
    if (chartInstances['delivery-cycle']) {
      chartInstances['delivery-cycle'].data.labels = lang === 'zh'
        ? ['1-2 天', '3-4 天', '5-6 天', '7+ 天']
        : ['1-2 days', '3-4 days', '5-6 days', '7+ days'];
      chartInstances['delivery-cycle'].update();
    }
  }
  
  // Make updateCharts globally accessible
  if (typeof window !== 'undefined') {
    window.updateCharts = updateCharts;
  }
  
  // Update all texts on page load
  function updatePageTexts(lang) {
    const t = translations[lang];
    if (!t) return;
    
    // Update all elements with data-i18n attribute (excluding header and footer which have their own handlers)
    document.querySelectorAll('main [data-i18n], [data-i18n]:not(header [data-i18n]):not(footer [data-i18n])').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value = t;
        for (const k of keys) {
          // Handle array indices (e.g., "whyUs.points.0.title")
          if (!isNaN(Number(k))) {
            value = value?.[Number(k)];
          } else {
            value = value?.[k];
          }
        }
        if (value && typeof value === 'string') {
          el.textContent = value;
        }
      }
    });
    
    // Update chart labels if charts are already initialized
    updateCharts(lang);
  }
  
  // Make function globally accessible
  if (typeof window !== 'undefined') {
    window.updatePageTexts = updatePageTexts;
  }
  
  // Initialize charts function
  function initializeCharts() {
    // Check if Chart.js is available (from CDN or import)
    let Chart;
    if (typeof window !== 'undefined' && window.Chart) {
      // Use CDN version
      Chart = window.Chart;
    } else {
      console.error('Chart.js is not available');
      return;
    }

    const currentLang = getLanguage();
    
    // 设计分级分布图表
    const designTierCanvas = document.getElementById('design-tier-chart');
    if (designTierCanvas && designTierCanvas instanceof HTMLCanvasElement) {
      // Destroy existing chart if it exists
      if (chartInstances['design-tier']) {
        chartInstances['design-tier'].destroy();
      }
      
      const ctx = designTierCanvas.getContext('2d');
      if (ctx) {
        const premiumCount = premiumCasesCount;
        const premiumPlusCount = premiumPlusCasesCount;
        
        chartInstances['design-tier'] = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: currentLang === 'zh'
              ? ['顶级设计', '优质设计']
              : ['Top-tier Design', 'Premium Design'],
            datasets: [{
              data: [premiumPlusCount, premiumCount],
              backgroundColor: [
                'rgba(248, 165, 194, 0.85)',
                'rgba(248, 147, 147, 0.85)'
              ],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: {
                    size: 12
                  }
                }
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const label = context.label || '';
                    const value = context.parsed || 0;
                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : '0';
                    return `${label}: ${value} (${percentage}%)`;
                  }
                }
              }
            }
          }
        });
        console.log('Design tier chart initialized');
      }
    } else {
      console.warn('Design tier canvas not found');
    }

    // 服务类型分布图表
    const serviceTypeCanvas = document.getElementById('service-type-chart');
    if (serviceTypeCanvas && serviceTypeCanvas instanceof HTMLCanvasElement) {
      // Destroy existing chart if it exists
      if (chartInstances['service-type']) {
        chartInstances['service-type'].destroy();
      }
      
      const ctx = serviceTypeCanvas.getContext('2d');
      if (ctx) {
        chartInstances['service-type'] = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: currentLang === 'zh' 
              ? ['网站设计', '前端开发', '品牌设计', 'UI/UX设计', '移动端开发']
              : ['Web Design', 'Frontend Dev', 'Brand Design', 'UI/UX Design', 'Mobile Dev'],
            datasets: [{
              label: currentLang === 'zh' ? '占比 (%)' : 'Percentage (%)',
              data: [85, 100, 60, 90, 75],
              backgroundColor: [
                'rgba(248, 147, 147, 0.85)',
                'rgba(255, 179, 186, 0.85)',
                'rgba(248, 165, 194, 0.85)',
                'rgba(255, 193, 204, 0.85)',
                'rgba(229, 115, 125, 0.85)'
              ],
              borderRadius: 8
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    return `${context.dataset.label}: ${context.parsed.y}%`;
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  callback: function(value) {
                    return value + '%';
                  }
                }
              }
            }
          }
        });
        console.log('Service type chart initialized');
      }
    } else {
      console.warn('Service type canvas not found');
    }

    // 交付周期统计图表
    const deliveryCycleCanvas = document.getElementById('delivery-cycle-chart');
    if (deliveryCycleCanvas && deliveryCycleCanvas instanceof HTMLCanvasElement) {
      // Destroy existing chart if it exists
      if (chartInstances['delivery-cycle']) {
        chartInstances['delivery-cycle'].destroy();
      }
      
      const ctx = deliveryCycleCanvas.getContext('2d');
      if (ctx) {
        chartInstances['delivery-cycle'] = new Chart(ctx, {
          type: 'pie',
          data: {
            labels: currentLang === 'zh'
              ? ['1-2 天', '3-4 天', '5-6 天', '7+ 天']
              : ['1-2 days', '3-4 days', '5-6 days', '7+ days'],
            datasets: [{
              data: [50, 40, 8, 2],
              backgroundColor: [
                'rgba(248, 147, 147, 0.85)',
                'rgba(255, 179, 186, 0.85)',
                'rgba(248, 165, 194, 0.85)',
                'rgba(255, 193, 204, 0.85)'
              ],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  font: {
                    size: 12
                  }
                }
              }
            }
          }
        });
        console.log('Delivery cycle chart initialized');
      }
    } else {
      console.warn('Delivery cycle canvas not found');
    }
  }

  // Initialize on page load
  function initPage() {
    const lang = getLanguage();
    updatePageTexts(lang);
    
    // Function to try initializing charts
    function tryInitCharts() {
      if (typeof window !== 'undefined' && window.Chart) {
        console.log('Chart.js found, initializing charts...');
        initializeCharts();
        return true;
      }
      return false;
    }
    
    // Try immediately
    if (!tryInitCharts()) {
      // If Chart.js not ready, wait for it
      let retries = 0;
      const maxRetries = 20; // 2 seconds max wait
      const checkInterval = setInterval(() => {
        retries++;
        if (tryInitCharts() || retries >= maxRetries) {
          clearInterval(checkInterval);
          if (retries >= maxRetries && !window.Chart) {
            console.error('Chart.js failed to load after', maxRetries * 100, 'ms');
          }
        }
      }, 100);
    }
  }
  
  document.addEventListener('DOMContentLoaded', () => {
    initPage();
    
    // Listen for language changes from other components
    window.addEventListener('storage', (e) => {
      if (e.key === 'language') {
        const newLang = e.newValue || 'zh';
        updatePageTexts(newLang);
        updateCharts(newLang);
      }
    });
    
    // Listen for language change events from Navbar
    window.addEventListener('languagechange', function(e) {
      const event = e;
      const newLang = event.detail && event.detail.lang;
      if (newLang) {
        updatePageTexts(newLang);
        updateCharts(newLang);
      }
    });
  });

  // Also try to initialize when window loads (fallback)
  if (typeof window !== 'undefined') {
    window.addEventListener('load', () => {
      if (!chartInstances['design-tier'] || 
          !chartInstances['service-type'] || 
          !chartInstances['delivery-cycle']) {
        console.log('Retrying chart initialization on window load');
        if (window.Chart) {
          initializeCharts();
        }
      }
    });
  }

</script>
