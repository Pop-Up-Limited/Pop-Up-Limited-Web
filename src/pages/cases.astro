---
import Layout from '../layouts/Layout.astro';
import { COMPANY_NAME } from '../config/site';
import { cases } from '../data/cases';
import CaseCard from '../components/CaseCard.astro';

const categories = Array.from(new Set(cases.map(c => c.category)));
const selectedCategory = Astro.url.searchParams.get('category') || 'all';
const selectedTier = Astro.url.searchParams.get('tier') || 'all';

// 按设计分级分组
const premiumCases = cases.filter(c => c.designTier === 'premium');
const premiumPlusCases = cases.filter(c => c.designTier === 'premium-plus');

// 筛选逻辑
let filteredCases = cases;
if (selectedCategory !== 'all') {
  filteredCases = filteredCases.filter(c => c.category === selectedCategory);
}
if (selectedTier === 'premium') {
  filteredCases = filteredCases.filter(c => c.designTier === 'premium');
} else if (selectedTier === 'premium-plus') {
  filteredCases = filteredCases.filter(c => c.designTier === 'premium-plus');
}
---

<Layout 
  title={`案例库 · ${COMPANY_NAME}`}
  description="浏览我们的成功案例，了解我们为不同行业客户打造的专业网站解决方案。"
>
  <div class="relative min-h-screen bg-surface dark:bg-surface-dark">
    <!-- Hero Section -->
    <section class="relative mx-auto w-full max-w-7xl px-4 pt-16 pb-8 md:px-6 md:pt-20 md:pb-12">
      <div class="absolute inset-x-0 -top-32 -z-10 h-[300px] bg-gradient-to-b from-brand-500/25 to-transparent blur-3xl"></div>
      <div class="text-center">
        <h1 class="text-3xl font-semibold leading-tight text-foreground md:text-4xl dark:text-foreground-dark">
          案例库
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base text-foreground-muted dark:text-slate-300">
          探索我们为不同行业客户打造的专业网站解决方案，从初创企业到大型企业的成功案例
        </p>
      </div>
    </section>

    <!-- Filter Section -->
    <section class="mx-auto w-full max-w-7xl px-4 pb-8 md:px-6">
      <div class="mb-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/cases"
          class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
            selectedCategory === 'all' && selectedTier === 'all'
              ? 'bg-brand-500 text-white'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          全部
        </a>
        {categories.map((category) => (
          <a
            href={`/cases?category=${encodeURIComponent(category)}${selectedTier !== 'all' ? `&tier=${selectedTier}` : ''}`}
            class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
              selectedCategory === category
                ? 'bg-brand-500 text-white'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
            }`}
          >
            {category}
          </a>
        ))}
      </div>
      
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href={`/cases${selectedCategory !== 'all' ? `?category=${selectedCategory}` : ''}`}
          class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
            selectedTier === 'all'
              ? 'bg-brand-500 text-white'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          全部设计
        </a>
        <a
          href={`/cases?tier=premium${selectedCategory !== 'all' ? `&category=${selectedCategory}` : ''}`}
          class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
            selectedTier === 'premium'
              ? 'bg-brand-500 text-white'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          优质设计（初级）
        </a>
        <a
          href={`/cases?tier=premium-plus${selectedCategory !== 'all' ? `&category=${selectedCategory}` : ''}`}
          class={`rounded-full px-4 py-2 text-sm font-semibold transition-colors ${
            selectedTier === 'premium-plus'
              ? 'bg-purple-500 text-white'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700'
          }`}
        >
          顶级设计（高级）
        </a>
      </div>
    </section>

    <!-- Cases Grid -->
    <section class="mx-auto w-full max-w-7xl px-4 pb-24 md:px-6">
      {selectedTier === 'all' && premiumCases.length > 0 && (
        <div class="mb-12">
          <div class="mb-6 flex items-center gap-3">
            <h2 class="text-2xl font-semibold text-foreground dark:text-foreground-dark">
              优质设计（初级）
            </h2>
            <span class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-600">
              {premiumCases.length} 个案例
            </span>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {premiumCases.map((caseItem) => (
              <CaseCard case={caseItem} />
            ))}
          </div>
        </div>
      )}

      {selectedTier === 'all' && premiumPlusCases.length > 0 && (
        <div class="mb-12">
          <div class="mb-6 flex items-center gap-3">
            <h2 class="text-2xl font-semibold text-foreground dark:text-foreground-dark">
              顶级设计（高级）
            </h2>
            <span class="rounded-full bg-purple-500/10 px-3 py-1 text-xs font-semibold text-purple-600">
              {premiumPlusCases.length} 个案例
            </span>
          </div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {premiumPlusCases.map((caseItem) => (
              <CaseCard case={caseItem} />
            ))}
          </div>
        </div>
      )}

      {selectedTier !== 'all' && (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {filteredCases.map((caseItem) => (
            <CaseCard case={caseItem} />
          ))}
        </div>
      )}
      
      {filteredCases.length === 0 && (
        <div class="py-12 text-center">
          <p class="text-lg text-foreground-muted dark:text-slate-400">
            暂无该分类的案例
          </p>
        </div>
      )}
    </section>
  </div>

  <!-- Case Detail Modal -->
  <div
    id="case-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4"
    data-modal
  >
    <div class="relative mx-auto w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl border border-slate-200 bg-white p-6 shadow-xl dark:border-slate-700 dark:bg-slate-900">
      <button
        type="button"
        data-modal-close
        class="absolute right-4 top-4 rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-800 dark:hover:text-slate-300"
        aria-label="关闭"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      
      <div id="case-modal-content">
        <!-- Content will be populated by JavaScript -->
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ cases: JSON.stringify(cases) }}>
  const modal = document.getElementById('case-modal');
  const modalContent = document.getElementById('case-modal-content');
  const viewButtons = document.querySelectorAll('[data-view-details]');
  const closeButton = document.querySelector('[data-modal-close]');

  function renderCaseDetails(caseItem: any) {
    return `
      <div class="space-y-6">
        <div class="relative h-64 overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800">
          ${caseItem.isLive && caseItem.url && caseItem.image ? `
            <a href="${caseItem.url}" target="_blank" rel="noopener noreferrer" class="block h-full w-full">
              <img
                src="${caseItem.image}"
                alt="${caseItem.name}"
                class="h-full w-full object-cover"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300 hover:opacity-100">
                <span class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white">
                  访问网站 →
                </span>
              </div>
            </a>
          ` : caseItem.isLive && caseItem.url ? `
            <iframe
              src="${caseItem.url}"
              class="h-full w-full"
              loading="lazy"
              title="${caseItem.name} 预览"
              allow="fullscreen"
              data-preview-iframe
            ></iframe>
          ` : `
            <img
              src="${caseItem.image}"
              alt="${caseItem.name}"
              class="h-full w-full object-cover"
            />
            <div class="absolute top-4 right-4">
              <span class="rounded-full bg-purple-500/90 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-white">
                设计稿
              </span>
            </div>
          `}
        </div>
        
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span class="rounded-full bg-brand-500/10 px-3 py-1 text-sm font-semibold text-brand-600">
              ${caseItem.category}
            </span>
            <span class="text-sm text-foreground-muted dark:text-slate-400">
              ${caseItem.year}
            </span>
          </div>
          
          <h2 class="mb-2 text-3xl font-semibold text-foreground dark:text-foreground-dark">
            ${caseItem.name}
          </h2>
          
          <p class="mb-6 text-lg text-foreground-muted dark:text-slate-300">
            ${caseItem.description}
          </p>
          
          <div class="mb-6 flex flex-wrap gap-2">
            ${caseItem.tags.map((tag: string) => `
              <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                ${tag}
              </span>
            `).join('')}
          </div>
          
          <div class="grid gap-6 md:grid-cols-2">
            <div>
              <h3 class="mb-3 text-lg font-semibold text-foreground dark:text-foreground-dark">
                服务内容
              </h3>
              <ul class="space-y-2">
                ${caseItem.details.services.map((service: string) => `
                  <li class="flex items-center gap-2 text-sm text-foreground-muted dark:text-slate-300">
                    <svg class="h-5 w-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    ${service}
                  </li>
                `).join('')}
              </ul>
            </div>
            
            <div>
              <h3 class="mb-3 text-lg font-semibold text-foreground dark:text-foreground-dark">
                项目亮点
              </h3>
              <ul class="space-y-2">
                ${caseItem.details.highlights.map((highlight: string) => `
                  <li class="flex items-start gap-2 text-sm text-foreground-muted dark:text-slate-300">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>${highlight}</span>
                  </li>
                `).join('')}
              </ul>
            </div>
          </div>
          
          ${caseItem.details.technologies ? `
            <div class="mt-6">
              <h3 class="mb-3 text-lg font-semibold text-foreground dark:text-foreground-dark">
                技术栈
              </h3>
              <div class="flex flex-wrap gap-2">
                ${caseItem.details.technologies.map((tech: string) => `
                  <span class="rounded-lg bg-brand-500/10 px-3 py-1.5 text-sm font-medium text-brand-600 dark:text-brand-400">
                    ${tech}
                  </span>
                `).join('')}
              </div>
            </div>
          ` : ''}
          
          <div class="mt-8 flex gap-3">
            ${caseItem.isLive && caseItem.url ? `
              <a
                href="${caseItem.url}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                访问网站 →
              </a>
            ` : `
              <span class="rounded-lg bg-slate-200 px-4 py-2 text-sm font-semibold text-slate-500 dark:bg-slate-700 dark:text-slate-400">
                设计稿 · 即将上线
              </span>
            `}
            <button
              type="button"
              data-modal-close
              class="btn-secondary"
            >
              关闭
            </button>
          </div>
        </div>
      </div>
    `;
  }

  function openModal(caseId: string) {
    const caseItem = JSON.parse(cases).find((c: any) => c.id === caseId);
    if (!caseItem) return;
    
    if (modalContent) {
      modalContent.innerHTML = renderCaseDetails(caseItem);
    }
    
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  viewButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const caseId = btn.getAttribute('data-case-id');
      if (caseId) {
        openModal(caseId);
      }
    });
  });

  if (closeButton) {
    closeButton.addEventListener('click', closeModal);
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Handle close buttons inside modal content
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.hasAttribute('data-modal-close')) {
      closeModal();
    }
  });

  // 处理 iframe 预览错误和交互
  document.querySelectorAll('[data-preview-iframe]').forEach((iframe) => {
    if (iframe instanceof HTMLIFrameElement) {
      iframe.addEventListener('error', () => {
        const overlay = iframe.parentElement?.querySelector('[data-preview-overlay]');
        if (overlay instanceof HTMLElement) {
          overlay.classList.remove('opacity-0');
        }
      });

      // 尝试在 iframe 加载后滚动到内容区域
      iframe.addEventListener('load', () => {
        try {
          const iframeDoc = iframe.contentDocument || iframe.contentWindow?.document;
          if (iframeDoc) {
            // 尝试滚动到主要内容区域
            const mainContent = iframeDoc.querySelector('main, #main, .main, [role="main"], article, .content');
            if (mainContent) {
              mainContent.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } else {
              // 如果没有找到 main 元素，尝试滚动到第一个有内容的区域
              const firstContent = iframeDoc.querySelector('h1, h2, p, section');
              if (firstContent) {
                firstContent.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          }
        } catch (e) {
          // 跨域限制，无法访问 iframe 内容，这是正常的
          console.log('无法访问 iframe 内容（跨域限制）');
        }
      });
    }
  });
</script>

