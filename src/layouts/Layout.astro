---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  COMPANY_NAME,
  COMPANY_TAGLINE,
  DEFAULT_DESCRIPTION
} from '../config/site';
import '../styles/global.css';
import { translations } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  ogImage,
  canonical,
  noIndex = false
} = Astro.props as Props;

const pageTitle = title ?? `${COMPANY_NAME} · ${COMPANY_TAGLINE}`;
const metaDescription = description ?? DEFAULT_DESCRIPTION;
const canonicalUrl =
  canonical ??
  (Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : 'https://example.com'); // TODO: replace example fallback if site config is updated
const ogImageUrl =
  ogImage ??
  (Astro.site
    ? new URL('/og-image-placeholder.svg', Astro.site).href
    : '/og-image-placeholder.svg'); // TODO: replace placeholder OG image
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  </head>
  <body class="bg-surface text-foreground dark:bg-surface-dark dark:text-foreground-dark">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand-500 focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>
    <Navbar currentPath={Astro.url.pathname} />
    <main id="main-content" class="relative">
      <slot />
    </main>
    <Footer />
    
    <!-- 动效系统加载 -->
    <script type="module">
      import { initAllAnimations } from '/src/utils/animations.js';
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initAllAnimations();
        });
      } else {
        initAllAnimations();
      }
    </script>
  </body>
</html>

<script define:vars={{ translations }}>
  // Get language from storage or URL
  function getLanguage() {
    if (typeof window === 'undefined') return 'zh';
    const stored = localStorage.getItem('language');
    const urlLang = new URLSearchParams(window.location.search).get('lang');
    return (urlLang === 'en' || urlLang === 'zh') ? urlLang : (stored === 'en' || stored === 'zh') ? stored : 'zh';
  }
  
  // Update all texts on page load
  function updatePageTexts(lang) {
    const t = translations[lang];
    if (!t) {
      console.warn('Translation not found for language:', lang);
      return;
    }
    
    // Update all elements with data-i18n attribute (excluding header and footer which have their own handlers)
    const elements = document.querySelectorAll('[data-i18n]');
    console.log('Found', elements.length, 'elements with data-i18n');
    
    elements.forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) {
        const keys = key.split('.');
        let value = t;
        for (const k of keys) {
          // Handle array indices (e.g., "whyUs.points.0.title")
          if (!isNaN(Number(k))) {
            value = value?.[Number(k)];
          } else {
            value = value?.[k];
          }
        }
        if (value && typeof value === 'string') {
          el.textContent = value;
        } else {
          console.warn('Translation value not found for key:', key, 'in language:', lang);
        }
      }
    });
    
    // Also trigger footer update if available
    if (typeof window.updateFooterTexts === 'function') {
      window.updateFooterTexts(lang);
    }
  }
  
  // Make updatePageTexts globally accessible
  if (typeof window !== 'undefined') {
    window.updatePageTexts = updatePageTexts;
    
    document.addEventListener('DOMContentLoaded', () => {
      const lang = getLanguage();
      updatePageTexts(lang);
    });
    
    // Listen for language change events from Navbar
    window.addEventListener('languagechange', function(e) {
      const event = e;
      const newLang = event.detail && event.detail.lang;
      if (newLang) {
        updatePageTexts(newLang);
      }
    });
    
    // Also listen for storage events
    window.addEventListener('storage', (e) => {
      if (e.key === 'language' && e.newValue) {
        const newLang = (e.newValue === 'en' || e.newValue === 'zh') ? e.newValue : 'zh';
        updatePageTexts(newLang);
      }
    });
  }
</script>
