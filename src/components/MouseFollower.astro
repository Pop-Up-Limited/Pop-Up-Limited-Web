<div id="mouse-follower" class="fixed pointer-events-none z-[9999]" style="display: none; top: 0; left: 0;">
  <svg width="24" height="30" viewBox="0 0 109 137" fill="none" xmlns="http://www.w3.org/2000/svg" class="cursor-icon">
    <path d="M74.8927 96.0206L74.5181 125.846C74.4792 128.945 72.7816 131.84 69.9646 133.132C65.7479 135.064 60.652 136.703 53.5257 136.704C47.1028 136.706 42.193 134.977 38.3021 133.204C35.3298 131.849 33.4899 128.792 33.4899 125.526V96.149C33.4899 90.5043 28.914 85.9284 23.2694 85.9284L10.2376 85.9284C2.0881 85.9284 -2.78364 76.8576 1.71689 70.0635L45.0969 4.57631C49.1145 -1.48886 58.0032 -1.53333 62.0814 4.49135L106.41 69.9785C111.005 76.7656 106.142 85.9284 97.9466 85.9284H85.1124C79.5178 85.9284 74.9629 90.4264 74.8927 96.0206Z" fill="currentColor"/>
  </svg>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const follower = document.getElementById('mouse-follower');
    if (!follower) return;

    let mouseX = 0;
    let mouseY = 0;
    let followerX = 0;
    let followerY = 0;
    let isHoveringClickable = false;

    // Smooth spring animation
    function animate() {
      const dx = mouseX - followerX;
      const dy = mouseY - followerY;
      
      // Spring physics (damping and stiffness)
      followerX += dx * 0.15;
      followerY += dy * 0.15;
      
      const scale = isHoveringClickable ? 1.8 : 1;
      const rotation = isHoveringClickable ? 45 : 0;
      
      // Center the icon on the mouse cursor
      const iconSize = 32;
      const offset = iconSize / 2;
      
      follower.style.transform = `translate(${followerX - offset}px, ${followerY - offset}px) scale(${scale}) rotate(${rotation}deg)`;
      
      requestAnimationFrame(animate);
    }

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      if (follower.style.display === 'none') {
        follower.style.display = 'block';
        followerX = mouseX;
        followerY = mouseY;
      }

      // Check if hovering over clickable elements
      const target = e.target;
      if (target && target instanceof HTMLElement) {
        const isClickable = target.closest('a, button, [role="button"], .btn-primary, .btn-secondary, [onclick], input, select, textarea');
        isHoveringClickable = !!isClickable;
      }
    });

    document.addEventListener('mouseleave', () => {
      follower.style.display = 'none';
    });

    animate();
  });
</script>

<style is:global>
  /* Hide system cursor globally */
  *, *::before, *::after {
    cursor: none !important;
  }
  
  #mouse-follower {
    will-change: transform;
    transition: color 0.3s ease;
  }
  
  #mouse-follower .cursor-icon {
    color: #a855f7;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
    transition: filter 0.3s ease, color 0.3s ease;
  }
  
  #mouse-follower:hover .cursor-icon,
  #mouse-follower.hover .cursor-icon {
    color: #c084fc;
    filter: drop-shadow(0 0 12px rgba(192, 132, 252, 0.7));
  }
</style>
