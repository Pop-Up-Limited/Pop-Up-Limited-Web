---
---
<div id="mouse-follower" class="fixed pointer-events-none z-[9999]" style="display: none; top: 0; left: 0;">
  <img src="/images/logo.svg" alt="Logo" class="w-8 h-8 opacity-80" style="display: block;" />
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const follower = document.getElementById('mouse-follower');
    if (!follower) return;

    let mouseX = 0;
    let mouseY = 0;
    let followerX = 0;
    let followerY = 0;
    let isHoveringClickable = false;

    // Smooth spring animation
    function animate() {
      const dx = mouseX - followerX;
      const dy = mouseY - followerY;
      
      // Spring physics (damping and stiffness)
      followerX += dx * 0.15;
      followerY += dy * 0.15;
      
      const scale = isHoveringClickable ? 1.5 : 1;
      const rotation = isHoveringClickable ? 45 : 0;
      
      // Center the icon on the mouse cursor (icon is 32px = w-8 h-8, so offset by half)
      const iconSize = 32; // w-8 h-8 = 32px
      const offset = iconSize / 2;
      
      follower.style.transform = `translate(${followerX - offset}px, ${followerY - offset}px) scale(${scale}) rotate(${rotation}deg)`;
      
      requestAnimationFrame(animate);
    }

    document.addEventListener('mousemove', (e) => {
      // Use clientX and clientY directly (relative to viewport)
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      if (follower.style.display === 'none') {
        follower.style.display = 'block';
        // Initialize position immediately to avoid lag
        followerX = mouseX;
        followerY = mouseY;
      }

      // Check if hovering over clickable elements
      const target = e.target;
      if (target && target instanceof HTMLElement) {
        const isClickable = target.closest('a, button, [role="button"], .btn-primary, .btn-secondary, [onclick]');
        isHoveringClickable = !!isClickable;
      }
    });

    document.addEventListener('mouseleave', () => {
      follower.style.display = 'none';
    });

    animate();
  });
</script>

<style>
  #mouse-follower {
    will-change: transform;
  }
  
  #mouse-follower img {
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }
</style>

