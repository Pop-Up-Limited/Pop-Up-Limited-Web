<div id="mouse-follower" class="fixed pointer-events-none z-[9999]" style="display: none; top: 0; left: 0;">
  <svg width="32" height="32" viewBox="0 0 250 250" fill="none" xmlns="http://www.w3.org/2000/svg" class="cursor-icon">
    <path d="M125 0C194.036 0 250 55.9644 250 125C250 194.036 194.036 250 125 250C55.9644 250 0 194.036 0 125C0 55.9644 55.9644 0 125 0ZM132.874 58.834C128.796 52.8094 119.907 52.8539 115.89 58.9189L72.5098 124.406C68.0092 131.2 72.8808 140.271 81.0303 140.271H94.0615C99.7061 140.271 104.282 144.847 104.282 150.491V179.868C104.282 183.134 106.122 186.193 109.095 187.547C112.986 189.32 117.896 191.048 124.318 191.047C131.444 191.045 136.54 189.407 140.757 187.475C143.574 186.183 145.272 183.288 145.311 180.189L145.686 150.363C145.756 144.769 150.311 140.271 155.905 140.271H168.739C176.935 140.271 181.797 131.108 177.203 124.321L132.874 58.834Z" fill="currentColor"/>
  </svg>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const follower = document.getElementById('mouse-follower');
    if (!follower) return;

    let mouseX = 0;
    let mouseY = 0;
    let followerX = 0;
    let followerY = 0;
    let isHoveringClickable = false;

    // Smooth spring animation
    function animate() {
      const dx = mouseX - followerX;
      const dy = mouseY - followerY;
      
      // Spring physics (damping and stiffness)
      followerX += dx * 0.15;
      followerY += dy * 0.15;
      
      const scale = isHoveringClickable ? 1.8 : 1;
      const rotation = isHoveringClickable ? 45 : 0;
      
      // Center the icon on the mouse cursor
      const iconSize = 32;
      const offset = iconSize / 2;
      
      follower.style.transform = `translate(${followerX - offset}px, ${followerY - offset}px) scale(${scale}) rotate(${rotation}deg)`;
      
      requestAnimationFrame(animate);
    }

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      if (follower.style.display === 'none') {
        follower.style.display = 'block';
        followerX = mouseX;
        followerY = mouseY;
      }

      // Check if hovering over clickable elements
      const target = e.target;
      if (target && target instanceof HTMLElement) {
        const isClickable = target.closest('a, button, [role="button"], .btn-primary, .btn-secondary, [onclick], input, select, textarea');
        isHoveringClickable = !!isClickable;
      }
    });

    document.addEventListener('mouseleave', () => {
      follower.style.display = 'none';
    });

    animate();
  });
</script>

<style is:global>
  /* Hide system cursor globally */
  *, *::before, *::after {
    cursor: none !important;
  }
  
  #mouse-follower {
    will-change: transform;
    transition: color 0.3s ease;
  }
  
  #mouse-follower .cursor-icon {
    color: #a855f7;
    filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
    transition: filter 0.3s ease, color 0.3s ease;
  }
  
  #mouse-follower:hover .cursor-icon,
  #mouse-follower.hover .cursor-icon {
    color: #c084fc;
    filter: drop-shadow(0 0 12px rgba(192, 132, 252, 0.7));
  }
</style>
