---
---
<div id="gemini-particles-container" class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
  <canvas id="gemini-canvas" class="w-full h-full opacity-80"></canvas>
</div>

<script>
  class ParticleSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: Particle[];
    width: number;
    height: number;
    mouseX: number;
    mouseY: number;
    hue: number;

    constructor() {
      this.canvas = document.getElementById('gemini-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;
      
      const context = this.canvas.getContext('2d');
      if (!context) return;
      this.ctx = context;

      this.particles = [];
      this.width = 0;
      this.height = 0;
      this.mouseX = 0;
      this.mouseY = 0;
      this.hue = 0;

      this.resize();
      window.addEventListener('resize', () => this.resize());
      
      // Track mouse relative to canvas, but canvas is fixed/absolute
      document.addEventListener('mousemove', (e) => {
        const rect = this.canvas.getBoundingClientRect();
        this.mouseX = e.clientX - rect.left;
        this.mouseY = e.clientY - rect.top;
        
        // Add particles on move
        for (let i = 0; i < 2; i++) {
          this.particles.push(new Particle(this.mouseX, this.mouseY, this.ctx));
        }
      });
      
      // Auto play if no mouse movement
      setInterval(() => {
         if (this.particles.length < 50) {
            const x = Math.random() * this.width;
            const y = Math.random() * this.height;
            this.particles.push(new Particle(x, y, this.ctx));
         }
      }, 100);

      this.animate();
    }

    resize() {
      this.width = this.canvas.width = this.canvas.offsetWidth;
      this.height = this.canvas.height = this.canvas.offsetHeight;
    }

    animate() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      // this.ctx.fillStyle = 'rgba(0,0,0,0.02)'; // Trail effect
      // this.ctx.fillRect(0, 0, this.width, this.height);

      this.handleParticles();
      this.hue += 0.5;
      requestAnimationFrame(() => this.animate());
    }

    handleParticles() {
      for (let i = 0; i < this.particles.length; i++) {
        this.particles[i].update();
        this.particles[i].draw();
        
        // Connect particles
        for (let j = i; j < this.particles.length; j++) {
            const dx = this.particles[i].x - this.particles[j].x;
            const dy = this.particles[i].y - this.particles[j].y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            
            if (distance < 100) {
                this.ctx.beginPath();
                this.ctx.strokeStyle = this.particles[i].color;
                this.ctx.lineWidth = 0.2;
                this.ctx.moveTo(this.particles[i].x, this.particles[i].y);
                this.ctx.lineTo(this.particles[j].x, this.particles[j].y);
                this.ctx.stroke();
                this.ctx.closePath();
            }
        }

        if (this.particles[i].size <= 0.3) {
          this.particles.splice(i, 1);
          i--;
        }
      }
    }
  }

  class Particle {
    x: number;
    y: number;
    size: number;
    speedX: number;
    speedY: number;
    color: string;
    ctx: CanvasRenderingContext2D;

    constructor(x: number, y: number, ctx: CanvasRenderingContext2D) {
      this.x = x;
      this.y = y;
      this.size = Math.random() * 8 + 1; // Size
      this.speedX = Math.random() * 3 - 1.5;
      this.speedY = Math.random() * 3 - 1.5;
      // Brand colors: Purple/Pink
      const colors = ['rgba(147, 51, 234, ', 'rgba(236, 72, 153, ', 'rgba(168, 85, 247, '];
      const randomColor = colors[Math.floor(Math.random() * colors.length)];
      this.color = randomColor + Math.random() + ')'; 
      this.ctx = ctx;
    }

    update() {
      this.x += this.speedX;
      this.y += this.speedY;
      if (this.size > 0.2) this.size -= 0.1;
    }

    draw() {
      this.ctx.fillStyle = this.color;
      this.ctx.beginPath();
      this.ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      this.ctx.fill();
    }
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    new ParticleSystem();
  });
</script>

