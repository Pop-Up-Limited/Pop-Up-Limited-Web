---
---
<canvas id="particle-canvas" class="absolute inset-0 w-full h-full"></canvas>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const canvas = document.getElementById('particle-canvas');
  if (!canvas) return;
  
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  // Configuration
  const particleCount = 800;
  const particles = [];
  let mouseX = 0;
  let mouseY = 0;
  let isMouseInCanvas = false;
  
  // Colors - pink/brand theme
  const colors = [
    'rgba(248, 165, 194, 0.8)',  // Light pink
    'rgba(247, 143, 179, 0.7)',  // Medium pink
    'rgba(251, 113, 133, 0.6)',  // Rose
    'rgba(255, 255, 255, 0.5)',  // White
    'rgba(245, 205, 121, 0.6)'   // Yellow accent
  ];

  // Resize canvas
  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  // Create particle
  function createParticle() {
    // Create particles in a sphere-like distribution on the right side
    const centerX = canvas.width * 0.65;
    const centerY = canvas.height * 0.5;
    const maxRadius = Math.min(canvas.width, canvas.height) * 0.35;
    
    // Spherical distribution
    const angle = Math.random() * Math.PI * 2;
    const radiusRatio = Math.cbrt(Math.random()); // Uniform volume distribution
    const radius = radiusRatio * maxRadius;
    
    // Add some vertical variation for 3D feel
    const yOffset = (Math.random() - 0.5) * radius * 0.5;
    
    return {
      x: centerX + Math.cos(angle) * radius,
      y: centerY + Math.sin(angle) * radius * 0.6 + yOffset,
      baseX: centerX + Math.cos(angle) * radius,
      baseY: centerY + Math.sin(angle) * radius * 0.6 + yOffset,
      size: Math.random() * 4 + 1,
      color: colors[Math.floor(Math.random() * colors.length)],
      angle: angle,
      radius: radius,
      speed: 0.002 + Math.random() * 0.003,
      vx: 0,
      vy: 0
    };
  }

  // Initialize particles
  for (let i = 0; i < particleCount; i++) {
    particles.push(createParticle());
  }

  // Mouse events
  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    isMouseInCanvas = true;
  });

  canvas.addEventListener('mouseleave', () => {
    isMouseInCanvas = false;
  });

  // Animation loop
  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    const centerX = canvas.width * 0.65;
    const centerY = canvas.height * 0.5;

    particles.forEach((p, i) => {
      // Rotate around center
      p.angle += p.speed;
      
      // Calculate new base position (circular motion)
      p.baseX = centerX + Math.cos(p.angle) * p.radius;
      p.baseY = centerY + Math.sin(p.angle) * p.radius * 0.6;
      
      // Mouse interaction - push particles away
      if (isMouseInCanvas) {
        const dx = p.x - mouseX;
        const dy = p.y - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const pushRadius = 120;
        
        if (dist < pushRadius && dist > 0) {
          const force = (pushRadius - dist) / pushRadius;
          const pushX = (dx / dist) * force * 15;
          const pushY = (dy / dist) * force * 15;
          p.vx += pushX;
          p.vy += pushY;
        }
      }
      
      // Apply velocity with damping
      p.x += p.vx;
      p.y += p.vy;
      p.vx *= 0.92;
      p.vy *= 0.92;
      
      // Return to base position with spring effect
      const returnForce = 0.03;
      p.x += (p.baseX - p.x) * returnForce;
      p.y += (p.baseY - p.y) * returnForce;
      
      // Draw particle with glow effect
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
      
      // Add subtle glow
      if (p.size > 2) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 2, 0, Math.PI * 2);
        ctx.fillStyle = p.color.replace('0.8', '0.1').replace('0.7', '0.1').replace('0.6', '0.1').replace('0.5', '0.05');
        ctx.fill();
      }
    });

    requestAnimationFrame(animate);
  }

  animate();
});
</script>

<style>
  #particle-canvas {
    pointer-events: auto;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }
</style>

