---
// Saturn Background - WebGL particle effect with Bloom and Intro Animation
---

<div id="saturn-bg-canvas"></div>

<script is:inline>
  // 等待页面完全加载
  window.addEventListener('load', function() {
    // 隐藏 UI 直到入场动画完成
    const navbar = document.querySelector('header');
    const mainContent = document.querySelector('main');
    const footer = document.querySelector('footer');
    
    if (navbar) {
      navbar.style.opacity = '0';
      navbar.style.transition = 'opacity 0.8s ease-out';
    }
    if (mainContent) {
      mainContent.style.opacity = '0';
      mainContent.style.transition = 'opacity 0.8s ease-out';
    }
    if (footer) {
      footer.style.opacity = '0';
      footer.style.transition = 'opacity 0.8s ease-out';
    }

    // 动态加载 Three.js
    const scripts = [
      'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js'
    ];

    let loadedCount = 0;

    function loadScript(url) {
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = url;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    async function loadAllScripts() {
      for (const url of scripts) {
        await loadScript(url);
        loadedCount++;
      }
      initSaturn();
    }

    function initSaturn() {
      console.log('Initializing Saturn with intro animation...');
      
      const container = document.getElementById('saturn-bg-canvas');
      if (!container) {
        console.error('Saturn container not found');
        return;
      }

      if (typeof THREE === 'undefined') {
        console.error('THREE is not defined');
        return;
      }

      // 配置
      const config = {
        particleCount: 50000,
        coreRadius: 15,
        ringInnerRadius: 25,
        ringOuterRadius: 75
      };

      let mouse = { x: 0, y: 0 };
      let targetZoom = 0;
      let currentZoom = 0;
      let scrollProgress = 0;
      
      // 入场动画状态
      let introProgress = 0;
      const introDuration = 2.0; // 2秒入场动画
      let introStartTime = null;
      let introComplete = false;

      // 场景
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x0a0515, 0.002);

      // 摄像机 - 初始位置很远
      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 1000);
      camera.position.set(0, 80, 300); // 从远处开始

      // 渲染器
      const renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.toneMapping = THREE.ReinhardToneMapping;
      container.appendChild(renderer.domElement);

      // 后处理
      const renderScene = new THREE.RenderPass(scene, camera);
      const bloomPass = new THREE.UnrealBloomPass(
        new THREE.Vector2(window.innerWidth, window.innerHeight),
        1.5, 0.4, 0.85
      );
      bloomPass.strength = 1.0;
      bloomPass.radius = 0.5;
      bloomPass.threshold = 0.1;

      const composer = new THREE.EffectComposer(renderer);
      composer.addPass(renderScene);
      composer.addPass(bloomPass);

      // 创建粒子
      const geometry = new THREE.BufferGeometry();
      const count = config.particleCount;
      const positions = [];
      const orbitParams = [];
      const randomness = [];
      const sizes = [];
      const colors = [];

      // 紫色调色板
      const colorCore = new THREE.Color(0x3E1D82);
      const colorRingInner = new THREE.Color(0x6B4BA3);
      const colorRingOuter = new THREE.Color(0x9b7ed9);
      const colorAccent = new THREE.Color(0xc4b5fd);

      for (let i = 0; i < count; i++) {
        let r, theta;
        let type = Math.random() < 0.15 ? 0 : 1;

        if (type === 0) {
          // 核心
          r = Math.random() * config.coreRadius;
          theta = Math.random() * Math.PI * 2;
          let phi = Math.acos((Math.random() * 2) - 1);
          positions.push(
            r * Math.sin(phi) * Math.cos(theta),
            r * Math.sin(phi) * Math.sin(theta),
            r * Math.cos(phi)
          );
          orbitParams.push(0, 0.5, 0);
          colors.push(colorCore.r, colorCore.g, colorCore.b);
          sizes.push(Math.random() * 1.5);
        } else {
          // 环
          let t = 1 - Math.pow(Math.random(), 2);
          let ringWidth = config.ringOuterRadius - config.ringInnerRadius;
          r = config.ringInnerRadius + t * ringWidth;

          if (r > 42 && r < 46 && Math.random() > 0.1) r += 5;
          theta = Math.random() * Math.PI * 2;
          positions.push(0, 0, 0);
          let speed = 5.0 / Math.sqrt(r);
          orbitParams.push(r, speed, theta);

          let colorMix = (r - config.ringInnerRadius) / ringWidth;
          let c = colorRingInner.clone().lerp(colorRingOuter, colorMix);
          if (Math.random() > 0.95) {
            c = colorAccent.clone();
          }
          colors.push(c.r, c.g, c.b);
          sizes.push(Math.random() * 1.2 + 0.3);
        }

        randomness.push(
          (Math.random() - 0.5) * 2,
          (Math.random() - 0.5) * 2,
          (Math.random() - 0.5) * 2
        );
      }

      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('aOrbit', new THREE.Float32BufferAttribute(orbitParams, 3));
      geometry.setAttribute('aRandom', new THREE.Float32BufferAttribute(randomness, 3));
      geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
      geometry.setAttribute('size', new THREE.Float32BufferAttribute(sizes, 1));

      const uniforms = {
        uTime: { value: 0 },
        uZoom: { value: 0 },
        uScroll: { value: 0 },
        uGlobalAlpha: { value: 1.0 },
        uIntro: { value: 0 }
      };

      const material = new THREE.ShaderMaterial({
        uniforms: uniforms,
        vertexShader: `
          uniform float uTime;
          uniform float uZoom;
          uniform float uScroll;
          uniform float uIntro;
          
          attribute vec3 aOrbit;
          attribute vec3 aRandom;
          attribute vec3 color;
          attribute float size;
          
          varying vec3 vColor;
          varying float vAlpha;

          void main() {
            vec3 newPos = position;
            float radius = aOrbit.x;
            
            // 入场动画：粒子从中心扩散
            float introScale = 0.3 + uIntro * 0.7;
            
            if (radius > 0.0) {
              float speed = aOrbit.y;
              float angle = aOrbit.z + uTime * speed * 0.1;
              newPos.x = cos(angle) * radius * introScale;
              newPos.z = sin(angle) * radius * introScale;
              newPos.y = sin(uTime * speed * 0.5 + aOrbit.z) * 0.5;
            } else {
              float angle = uTime * 0.2;
              float c = cos(angle); float s = sin(angle);
              float x = newPos.x * c - newPos.z * s;
              float z = newPos.x * s + newPos.z * c;
              newPos.x = x * introScale;
              newPos.z = z * introScale;
            }

            float chaos = smoothstep(0.7, 1.0, uZoom);
            if(chaos > 0.0) {
              vec3 jitter = aRandom * sin(uTime * 20.0 + aRandom.x) * (5.0 * chaos);
              newPos += jitter + normalize(newPos) * chaos * 10.0;
            }

            newPos.x *= (1.0 + uScroll * 0.2);
            newPos.z *= (1.0 + uScroll * 0.2);

            vec4 mvPosition = modelViewMatrix * vec4(newPos, 1.0);
            gl_Position = projectionMatrix * mvPosition;

            float brightness = 0.6 + uZoom * 1.0 - uScroll * 0.5 + (1.0 - uIntro) * 0.3;
            brightness = max(0.2, brightness);

            float distScale = 300.0 / -mvPosition.z;
            gl_PointSize = size * distScale * (1.0 + uZoom);

            vColor = color * brightness;

            float distToCam = length(mvPosition.xyz);
            vAlpha = smoothstep(5.0, 20.0, distToCam);
            vAlpha *= (1.0 - uScroll * 0.5);
          }
        `,
        fragmentShader: `
          varying vec3 vColor;
          varying float vAlpha;
          uniform float uGlobalAlpha;

          void main() {
            vec2 xy = gl_PointCoord.xy - vec2(0.5);
            float ll = length(xy);
            if(ll > 0.5) discard;
            
            float strength = 1.0 - (ll * 2.0);
            strength = pow(strength, 2.0);

            gl_FragColor = vec4(vColor, vAlpha * strength * uGlobalAlpha);
          }
        `,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });

      const particleSystem = new THREE.Points(geometry, material);
      particleSystem.rotation.x = Math.PI / 6;
      particleSystem.rotation.z = Math.PI / 12;
      scene.add(particleSystem);

      console.log('Saturn particle system created with', count, 'particles');

      // 事件监听
      window.addEventListener('resize', function() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
      });

      document.addEventListener('mousemove', function(e) {
        if (!introComplete) return; // 入场动画期间不响应鼠标
        
        if (window.scrollY < window.innerHeight) {
          mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
          mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
          const dist = Math.sqrt(mouse.x * mouse.x + mouse.y * mouse.y);
          targetZoom = 1.0 - Math.min(dist, 1.0);
        } else {
          targetZoom = 0;
        }
      });

      window.addEventListener('scroll', function() {
        if (!introComplete) return;
        scrollProgress = Math.min(window.scrollY / window.innerHeight, 1.0);
      });

      // Easing function for smooth animation
      function easeOutCubic(t) {
        return 1 - Math.pow(1 - t, 3);
      }
      
      function easeInOutQuart(t) {
        return t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;
      }

      // 动画循环
      function animate() {
        requestAnimationFrame(animate);
        const time = performance.now() * 0.001;

        // 入场动画逻辑
        if (!introComplete) {
          if (introStartTime === null) {
            introStartTime = time;
          }
          
          const elapsed = time - introStartTime;
          introProgress = Math.min(elapsed / introDuration, 1.0);
          const easedProgress = easeInOutQuart(introProgress);
          
          // 相机从远处拉近
          const startZ = 300;
          const endZ = 100;
          const startY = 80;
          const endY = 20;
          
          camera.position.z = startZ + (endZ - startZ) * easedProgress;
          camera.position.y = startY + (endY - startY) * easedProgress;
          
          // 旋转效果
          particleSystem.rotation.y = (1 - easedProgress) * Math.PI * 0.5;
          
          // 更新 shader uniform
          uniforms.uIntro.value = easedProgress;
          
          // Bloom 强度变化
          bloomPass.strength = 0.5 + easedProgress * 0.5;
          
          if (introProgress >= 1.0) {
            introComplete = true;
            console.log('Intro animation complete');
            
            // 显示 UI
            if (navbar) navbar.style.opacity = '1';
            if (mainContent) mainContent.style.opacity = '1';
            if (footer) footer.style.opacity = '1';
          }
        } else {
          // 正常动画逻辑
          currentZoom += (targetZoom - currentZoom) * 0.05;
          uniforms.uZoom.value = currentZoom;
          uniforms.uScroll.value += (scrollProgress - uniforms.uScroll.value) * 0.05;
          uniforms.uGlobalAlpha.value = 1.0 - uniforms.uScroll.value * 0.4;

          const baseRotX = Math.PI / 6;
          const targetRotX = baseRotX + scrollProgress * 0.5;
          particleSystem.rotation.x += (targetRotX - particleSystem.rotation.x) * 0.05;
          
          // 轻微的相机漂移
          camera.position.x += (Math.sin(time * 0.1) * 5 - camera.position.x) * 0.01;
        }

        uniforms.uTime.value = time;
        camera.lookAt(0, 0, 0);
        composer.render();
      }

      animate();
      console.log('Saturn animation started');
    }

    loadAllScripts().catch(err => {
      console.error('Failed to load scripts:', err);
    });
  });
</script>

<style>
  #saturn-bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    display: block;
    pointer-events: auto;
    background: linear-gradient(135deg, #0a0515 0%, #1a0a2e 50%, #0f0720 100%);
  }

  #saturn-bg-canvas canvas {
    display: block;
  }
</style>
