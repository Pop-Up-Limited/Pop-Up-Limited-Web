---
// Saturn Background - WebGL particle effect with Bloom and Intro Animation
// Immediate Visibility Version
---

<div id="saturn-bg-canvas"></div>

<!-- UI 延迟显示的样式 -->
<style is:global>
  body {
    background-color: #0a0515;
    margin: 0;
    overflow-x: hidden;
  }
  
  /* 核心 UI 元素初始隐藏，2.5秒后淡入 */
  header, main, footer {
    opacity: 0;
    animation: ui-fade-in 1.5s ease-out 2.0s forwards;
  }

  @keyframes ui-fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #saturn-bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    display: block;
    pointer-events: auto;
    /* 使用 CSS 渐变作为 Canvas 加载前的托底，避免纯黑 */
    background: linear-gradient(135deg, #0a0515 0%, #1a0a2e 50%, #0f0720 100%);
  }
  
  #saturn-bg-canvas canvas {
    display: block;
    /* 确保 Canvas 加载出来前不覆盖背景 */
    opacity: 0;
    animation: canvas-fade-in 0.5s ease-out forwards;
  }
  
  @keyframes canvas-fade-in {
    to { opacity: 1; }
  }
</style>

<script is:inline>
  (function() {
    // 动态加载脚本
    const scripts = [
      'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js',
      'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js'
    ];

    function loadScript(url) {
      return new Promise((resolve, reject) => {
        if (document.querySelector(`script[src="${url}"]`)) {
          resolve();
          return;
        }
        const script = document.createElement('script');
        script.src = url;
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    async function init() {
      try {
        for (const url of scripts) {
          await loadScript(url);
        }
        startSaturn();
      } catch (e) {
        console.error('Saturn load error:', e);
        // 出错也要显示 UI
        document.querySelectorAll('header, main, footer').forEach(el => el.style.opacity = 1);
      }
    }

    function startSaturn() {
      const container = document.getElementById('saturn-bg-canvas');
      if (!container || !window.THREE) return;

      // === 核心配置 ===
      const config = {
        particleCount: 25000,
        coreRadius: 12,
        ringInnerRadius: 22,
        ringOuterRadius: 70
      };

      // === 场景搭建 ===
      const scene = new THREE.Scene();
      // 移除雾效，确保清晰
      // scene.fog = new THREE.FogExp2(0x0a0515, 0.002);

      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 1000);
      // 初始相机位置：正中，稍远，确保第一眼看到完整的土星
      camera.position.set(0, 40, 220);

      const renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      // === 后处理 ===
      const renderScene = new THREE.RenderPass(scene, camera);
      const bloomPass = new THREE.UnrealBloomPass(
        new THREE.Vector2(window.innerWidth, window.innerHeight),
        1.5, 0.4, 0.85
      );
      bloomPass.strength = 1.2;
      bloomPass.radius = 0.4;
      bloomPass.threshold = 0.1;

      const composer = new THREE.EffectComposer(renderer);
      composer.addPass(renderScene);
      composer.addPass(bloomPass);

      // === 粒子系统 ===
      const geometry = new THREE.BufferGeometry();
      const positions = [];
      const orbitParams = [];
      const randomness = [];
      const colors = [];
      const sizes = [];

      const colorCore = new THREE.Color(0x3E1D82);
      const colorRingInner = new THREE.Color(0x6B4BA3);
      const colorRingOuter = new THREE.Color(0x9b7ed9);
      const colorAccent = new THREE.Color(0xc4b5fd);

      for (let i = 0; i < config.particleCount; i++) {
        let r, theta, x, y, z;
        if (Math.random() < 0.15) {
          r = Math.random() * config.coreRadius;
          theta = Math.random() * Math.PI * 2;
          const phi = Math.acos((Math.random() * 2) - 1);
          x = r * Math.sin(phi) * Math.cos(theta);
          y = r * Math.sin(phi) * Math.sin(theta);
          z = r * Math.cos(phi);
          positions.push(x, y, z);
          orbitParams.push(0, 0.5, 0);
          colors.push(colorCore.r, colorCore.g, colorCore.b);
          sizes.push(Math.random() * 1.2 + 0.3);
        } else {
          const t = Math.random();
          r = config.ringInnerRadius + t * (config.ringOuterRadius - config.ringInnerRadius);
          theta = Math.random() * Math.PI * 2;
          positions.push(0, 0, 0);
          orbitParams.push(r, 12.0 / Math.sqrt(r), theta);
          const mix = (r - config.ringInnerRadius) / (config.ringOuterRadius - config.ringInnerRadius);
          const c = colorRingInner.clone().lerp(colorRingOuter, mix);
          if (Math.random() > 0.98) c.copy(colorAccent);
          colors.push(c.r, c.g, c.b);
          sizes.push(Math.random() * 1.0 + 0.2);
        }
        randomness.push(Math.random(), Math.random(), Math.random());
      }

      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('aOrbit', new THREE.Float32BufferAttribute(orbitParams, 3));
      geometry.setAttribute('aRandom', new THREE.Float32BufferAttribute(randomness, 3));
      geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
      geometry.setAttribute('size', new THREE.Float32BufferAttribute(sizes, 1));

      const uniforms = {
        uTime: { value: 0 },
        uIntro: { value: 0 },
        uScroll: { value: 0 },
        uZoom: { value: 0 }
      };

      const material = new THREE.ShaderMaterial({
        uniforms: uniforms,
        vertexShader: `
          uniform float uTime;
          uniform float uIntro;
          uniform float uScroll;
          uniform float uZoom;
          attribute vec3 aOrbit;
          attribute vec3 aRandom;
          attribute vec3 color;
          attribute float size;
          varying vec3 vColor;
          varying float vAlpha;

          void main() {
            vec3 pos = position;
            float radius = aOrbit.x;
            
            // 关键修改：初始就是可见的，不要从 0 开始放大
            // uIntro 从 0 到 1
            // Scale 稍微动一下，更有动感，但初始值要是 1.0 (正常大小)
            // 实际上我们不需要缩放动画了，因为要做的是位移
            float scale = 1.0;

            if (radius > 0.0) {
              float speed = aOrbit.y;
              float angle = aOrbit.z + uTime * speed * 0.1;
              pos.x = cos(angle) * radius * scale;
              pos.z = sin(angle) * radius * scale;
              pos.y = sin(uTime * speed * 0.5 + aOrbit.z) * 0.5 * scale;
            } else {
              float angle = uTime * 0.2;
              float c = cos(angle); float s = sin(angle);
              float x = pos.x; float z = pos.z;
              pos.x = (x * c - z * s) * scale;
              pos.z = (x * s + z * c) * scale;
              pos.y *= scale;
            }

            // Scroll effect
            pos *= (1.0 + uScroll * 0.5);

            vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
            gl_Position = projectionMatrix * mvPosition;

            float dist = length(mvPosition.xyz);
            gl_PointSize = size * (350.0 / -mvPosition.z);
            
            // 颜色始终可见
            vColor = color;
            vAlpha = smoothstep(1.0, 50.0, dist);
          }
        `,
        fragmentShader: `
          varying vec3 vColor;
          varying float vAlpha;
          void main() {
            vec2 xy = gl_PointCoord.xy - 0.5;
            if (length(xy) > 0.5) discard;
            gl_FragColor = vec4(vColor, vAlpha);
          }
        `,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });

      const particleSystem = new THREE.Points(geometry, material);
      // 初始旋转角度
      particleSystem.rotation.x = Math.PI / 6;
      particleSystem.rotation.z = Math.PI / 12;
      scene.add(particleSystem);

      // === 动画循环逻辑 ===
      const introDuration = 2.0; // 2秒入场
      const startTime = performance.now() / 1000;
      
      let mouseX = 0, mouseY = 0;
      let scrollY = 0;

      window.addEventListener('mousemove', e => {
        mouseX = (e.clientX / window.innerWidth) * 2 - 1;
        mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
      });
      window.addEventListener('scroll', () => {
        scrollY = window.scrollY / window.innerHeight;
      });
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        composer.setSize(window.innerWidth, window.innerHeight);
      });

      function animate() {
        requestAnimationFrame(animate);
        
        const now = performance.now() / 1000;
        const elapsed = now - startTime;
        
        // 计算入场进度 0 -> 1
        let progress = Math.min(elapsed / introDuration, 1.0);
        // 缓动函数 easeInOutCubic - 平滑起步和结束
        progress = progress < 0.5 ? 4 * progress * progress * progress : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        uniforms.uTime.value = now;
        uniforms.uIntro.value = progress;

        // === 关键帧运镜 ===
        // 1. 位置平移：从正中间(0) 移动到右侧(4.5)
        // 初始就是可见的，在中间
        const targetX = 4.5;
        particleSystem.position.x = progress * targetX;

        // 2. 相机推进：从稍远(220) 到 标准位置(100)
        // 这样土星会变大，有一种扑面而来然后移开的感觉
        camera.position.z = 220 - progress * 120; // 最终 100
        camera.position.y = 40 - progress * 20;   // 最终 20

        // 3. 旋转展示：转半圈展示全貌
        particleSystem.rotation.y = (1 - progress) * Math.PI * 0.5;

        // === 交互逻辑 (入场后生效) ===
        if (progress >= 0.95) {
          // 鼠标 Zoom
          const dist = Math.sqrt(mouseX*mouseX + mouseY*mouseY);
          const targetZoom = (scrollY < 0.1 && dist < 0.5) ? (1.0 - dist*2.0) : 0;
          uniforms.uZoom.value += (targetZoom - uniforms.uZoom.value) * 0.05;
          
          // 滚动
          uniforms.uScroll.value += (scrollY - uniforms.uScroll.value) * 0.05;
          
          // 滚动旋转
          const baseRotX = Math.PI/6;
          const targetRotX = baseRotX + scrollY * 0.5;
          particleSystem.rotation.x += (targetRotX - particleSystem.rotation.x) * 0.05;
          
          // 滚动时跟随
          particleSystem.position.y = -scrollY * 10;
        }

        // 始终看向中心，配合 position.x 的移动，视觉上土星会移到右边
        camera.lookAt(0, 0, 0);
        
        composer.render();
      }

      animate();
    }

    init();
  })();
</script>
