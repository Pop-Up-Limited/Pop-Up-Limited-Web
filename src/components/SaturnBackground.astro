---
// Saturn Background - WebGL particle effect
---

<div id="saturn-bg-canvas"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>

<script>
  class SaturnBackground {
    constructor(containerId) {
      this.container = document.getElementById(containerId);
      if (!this.container) {
        console.error(`Container ${containerId} not found`);
        return;
      }

      // 配置参数 - 使用紫色调
      this.config = {
        particleCount: 60000,
        baseColor: new THREE.Color(0x9b7ed9), // 紫色
        coreRadius: 15,
        ringInnerRadius: 25,
        ringOuterRadius: 75,
        chaosThreshold: 0.85
      };

      this.mouse = new THREE.Vector2(0, 0);
      this.targetZoom = 0;
      this.currentZoom = 0;
      this.scrollProgress = 0;

      this.init();
      this.createParticles();
      this.addEventListeners();
      this.animate();
    }

    init() {
      this.scene = new THREE.Scene();
      this.scene.fog = new THREE.FogExp2(0x0a0515, 0.002); // 深紫色雾

      this.camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 1000);
      this.camera.position.set(0, 20, 100);

      this.renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });
      this.renderer.setSize(window.innerWidth, window.innerHeight);
      this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      this.renderer.toneMapping = THREE.ReinhardToneMapping;
      this.container.appendChild(this.renderer.domElement);

      const renderScene = new THREE.RenderPass(this.scene, this.camera);
      const bloomPass = new THREE.UnrealBloomPass(
        new THREE.Vector2(window.innerWidth, window.innerHeight),
        1.5, 0.4, 0.85
      );
      bloomPass.strength = 1.2;
      bloomPass.radius = 0.6;
      bloomPass.threshold = 0.1;

      this.composer = new THREE.EffectComposer(this.renderer);
      this.composer.addPass(renderScene);
      this.composer.addPass(bloomPass);
    }

    createParticles() {
      const geometry = new THREE.BufferGeometry();
      const count = this.config.particleCount;
      const positions = [];
      const orbitParams = [];
      const randomness = [];
      const sizes = [];
      const colors = [];

      // 紫色调色板
      const colorCore = new THREE.Color(0x3E1D82);      // 深紫核心
      const colorRingInner = new THREE.Color(0x6B4BA3); // 中紫
      const colorRingOuter = new THREE.Color(0x9b7ed9); // 浅紫
      const colorAccent = new THREE.Color(0xc4b5fd);    // 淡紫光

      for (let i = 0; i < count; i++) {
        let r, theta;
        let type = Math.random() < 0.15 ? 0 : 1;

        if (type === 0) {
          r = Math.random() * this.config.coreRadius;
          theta = Math.random() * Math.PI * 2;
          let phi = Math.acos((Math.random() * 2) - 1);
          positions.push(
            r * Math.sin(phi) * Math.cos(theta),
            r * Math.sin(phi) * Math.sin(theta),
            r * Math.cos(phi)
          );
          orbitParams.push(0, 0.5, 0);
          colors.push(colorCore.r, colorCore.g, colorCore.b);
          sizes.push(Math.random() * 1.5);
        } else {
          let t = 1 - Math.pow(Math.random(), 2);
          let ringWidth = this.config.ringOuterRadius - this.config.ringInnerRadius;
          r = this.config.ringInnerRadius + t * ringWidth;

          if (r > 42 && r < 46 && Math.random() > 0.1) r += 5;
          theta = Math.random() * Math.PI * 2;
          positions.push(0, 0, 0);
          let speed = 5.0 / Math.sqrt(r);
          orbitParams.push(r, speed, theta);

          let colorMix = (r - this.config.ringInnerRadius) / ringWidth;
          let c = colorRingInner.clone().lerp(colorRingOuter, colorMix);
          // 随机添加一些亮点
          if (Math.random() > 0.95) {
            c = colorAccent.clone();
          }
          colors.push(c.r, c.g, c.b);
          sizes.push(Math.random() * 1.2 + 0.3);
        }

        randomness.push(
          (Math.random() - 0.5) * 2,
          (Math.random() - 0.5) * 2,
          (Math.random() - 0.5) * 2
        );
      }

      geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
      geometry.setAttribute('aOrbit', new THREE.Float32BufferAttribute(orbitParams, 3));
      geometry.setAttribute('aRandom', new THREE.Float32BufferAttribute(randomness, 3));
      geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
      geometry.setAttribute('size', new THREE.Float32BufferAttribute(sizes, 1));

      this.uniforms = {
        uTime: { value: 0 },
        uZoom: { value: 0 },
        uScroll: { value: 0 },
        uGlobalAlpha: { value: 1.0 },
        uResolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) }
      };

      const material = new THREE.ShaderMaterial({
        uniforms: this.uniforms,
        vertexShader: `
          uniform float uTime;
          uniform float uZoom;
          uniform float uScroll;
          
          attribute vec3 aOrbit;
          attribute vec3 aRandom;
          attribute vec3 color;
          attribute float size;
          
          varying vec3 vColor;
          varying float vAlpha;

          void main() {
            vec3 newPos = position;
            float radius = aOrbit.x;
            
            if (radius > 0.0) {
              float speed = aOrbit.y;
              float angle = aOrbit.z + uTime * speed * 0.1;
              newPos.x = cos(angle) * radius;
              newPos.z = sin(angle) * radius;
              newPos.y = sin(uTime * speed * 0.5 + aOrbit.z) * 0.5;
            } else {
              float angle = uTime * 0.2;
              float c = cos(angle); float s = sin(angle);
              float x = newPos.x * c - newPos.z * s;
              float z = newPos.x * s + newPos.z * c;
              newPos.x = x; newPos.z = z;
            }

            float chaos = smoothstep(0.7, 1.0, uZoom);
            if(chaos > 0.0) {
              vec3 jitter = aRandom * sin(uTime * 20.0 + aRandom.x) * (5.0 * chaos);
              newPos += jitter + normalize(newPos) * chaos * 10.0;
            }

            newPos.x *= (1.0 + uScroll * 0.2);
            newPos.z *= (1.0 + uScroll * 0.2);

            vec4 mvPosition = modelViewMatrix * vec4(newPos, 1.0);
            gl_Position = projectionMatrix * mvPosition;

            float brightness = 0.6 + uZoom * 1.0 - uScroll * 0.5;
            brightness = max(0.2, brightness);

            float distScale = 300.0 / -mvPosition.z;
            gl_PointSize = size * distScale * (1.0 + uZoom);

            vColor = color * brightness;

            float distToCam = length(mvPosition.xyz);
            vAlpha = smoothstep(5.0, 20.0, distToCam);
            vAlpha *= (1.0 - uScroll * 0.5);
          }
        `,
        fragmentShader: `
          varying vec3 vColor;
          varying float vAlpha;
          uniform float uGlobalAlpha;

          void main() {
            vec2 xy = gl_PointCoord.xy - vec2(0.5);
            float ll = length(xy);
            if(ll > 0.5) discard;
            
            float strength = 1.0 - (ll * 2.0);
            strength = pow(strength, 2.0);

            gl_FragColor = vec4(vColor, vAlpha * strength * uGlobalAlpha);
          }
        `,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });

      this.particleSystem = new THREE.Points(geometry, material);
      this.particleSystem.rotation.x = Math.PI / 6;
      this.particleSystem.rotation.z = Math.PI / 12;
      this.scene.add(this.particleSystem);
    }

    addEventListeners() {
      window.addEventListener('resize', () => {
        this.camera.aspect = window.innerWidth / window.innerHeight;
        this.camera.updateProjectionMatrix();
        this.renderer.setSize(window.innerWidth, window.innerHeight);
        this.composer.setSize(window.innerWidth, window.innerHeight);
        this.uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
      });

      document.addEventListener('mousemove', (e) => {
        if (window.scrollY < window.innerHeight) {
          this.mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
          this.mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
          const dist = Math.sqrt(this.mouse.x ** 2 + this.mouse.y ** 2);
          this.targetZoom = 1.0 - Math.min(dist, 1.0);
        } else {
          this.targetZoom = 0;
        }
      });

      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        this.scrollProgress = Math.min(scrollY / window.innerHeight, 1.0);
      });
    }

    animate() {
      requestAnimationFrame(this.animate.bind(this));
      const time = performance.now() * 0.001;

      this.currentZoom += (this.targetZoom - this.currentZoom) * 0.05;

      this.uniforms.uTime.value = time;
      this.uniforms.uZoom.value = this.currentZoom;
      this.uniforms.uScroll.value += (this.scrollProgress - this.uniforms.uScroll.value) * 0.05;
      this.uniforms.uGlobalAlpha.value = 1.0 - this.uniforms.uScroll.value * 0.4;

      const baseRotX = Math.PI / 6;
      const targetRotX = baseRotX + this.scrollProgress * 0.5;
      this.particleSystem.rotation.x += (targetRotX - this.particleSystem.rotation.x) * 0.05;

      this.camera.position.x += (Math.sin(time * 0.1) * 5 - this.camera.position.x) * 0.01;
      this.camera.lookAt(0, 0, 0);

      this.composer.render();
    }
  }

  // 初始化
  if (typeof window !== 'undefined') {
    window.addEventListener('load', () => {
      new SaturnBackground('saturn-bg-canvas');
    });
  }
</script>

<style>
  #saturn-bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    display: block;
    pointer-events: auto;
    background: linear-gradient(135deg, #0a0515 0%, #1a0a2e 50%, #0a0515 100%);
  }

  #saturn-bg-canvas canvas {
    display: block;
  }
</style>

