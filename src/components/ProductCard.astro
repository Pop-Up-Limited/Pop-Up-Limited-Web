---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="card-surface h-full flex flex-col overflow-hidden transition-all duration-300 hover:shadow-lg">
  {product.image && (
    <div class="relative -mx-6 -mt-6 mb-4 h-48 overflow-hidden">
      <img
        src={product.image}
        alt={product.name}
        class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
      {product.badge && (
        <span class="absolute top-4 right-4 rounded-full bg-brand-500/90 backdrop-blur-sm px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
          {product.badge}
        </span>
      )}
    </div>
  )}
  
  <div class="flex flex-1 flex-col gap-4 px-6 pb-6">
    {!product.image && (
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-foreground dark:text-foreground-dark">
          {product.name}
        </h3>
        {product.badge && (
          <span class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand-600">
            {product.badge}
          </span>
        )}
      </div>
    )}
    
    {product.image && (
      <h3 class="text-lg font-semibold text-foreground dark:text-foreground-dark">
        {product.name}
      </h3>
    )}

    <p class="flex-1 text-sm text-foreground-muted dark:text-slate-300">
      {product.description}
    </p>

    <div class="mt-auto flex items-center justify-between">
      <a
        href={product.link}
        class="btn-secondary"
        target={product.link.startsWith('http') ? '_blank' : undefined}
        rel={product.link.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        {product.linkLabel}
      </a>
      {product.status && (
        <span class="text-xs uppercase tracking-wide text-slate-400">
          {product.status === 'coming-soon' ? 'Coming Soon' : product.status}
        </span>
      )}
    </div>
  </div>
</article>

