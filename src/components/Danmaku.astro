---
const { items = ["Web Design", "UI/UX", "Branding", "Development", "SEO", "Marketing", "App Development", "Consulting"] } = Astro.props;
---

<div class="relative w-full overflow-hidden bg-brand-50/50 py-6 dark:bg-brand-900/10">
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-surface to-transparent dark:from-surface-dark"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-surface to-transparent dark:from-surface-dark"></div>
  
  <div class="flex gap-8 animate-marquee whitespace-nowrap">
    {[...items, ...items, ...items, ...items].map((item) => (
      <span class="inline-flex items-center rounded-full border border-brand-200 bg-white px-6 py-2 text-lg font-medium text-brand-700 shadow-sm dark:border-brand-800 dark:bg-slate-800 dark:text-brand-300">
        {item}
      </span>
    ))}
  </div>
</div>

<style>
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>

