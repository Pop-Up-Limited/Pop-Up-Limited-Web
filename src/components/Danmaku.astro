---
const { items = ["Web Design", "UI/UX", "Branding", "Development", "SEO", "Marketing", "App Development", "Consulting"] } = Astro.props;
---

<div class="relative w-full overflow-hidden py-6">
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-black to-transparent"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-black to-transparent"></div>
  
  <div class="flex gap-8 animate-marquee whitespace-nowrap">
    {[...items, ...items, ...items, ...items].map((item) => (
      <span class="inline-flex items-center rounded-full border border-white/50 bg-transparent px-6 py-2 text-lg font-medium text-white">
        {item}
      </span>
    ))}
  </div>
</div>

<style>
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
