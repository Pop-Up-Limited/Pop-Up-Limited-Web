---
---
<div id="three-saturn-container" class="absolute inset-0 z-0 pointer-events-none w-full h-full"></div>

<script>
  async function initSaturn() {
    try {
      console.log('Starting Saturn initialization...');
      
      // Dynamic import for Three.js
      const THREE = await import('three');
      
      console.log('Three.js loaded:', THREE);
      
      if (!THREE || !THREE.Scene) {
        console.error('Three.js not properly loaded');
        return;
      }

      const container = document.getElementById('three-saturn-container');
      if (!container) {
        console.error('Container element not found');
        return;
      }
      
      console.log('Container found, creating scene...');

      class SaturnScene {
        constructor() {
          this.container = container;
          this.scene = new THREE.Scene();
          this.camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
          this.renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
          
          this.renderer.setSize(window.innerWidth, window.innerHeight);
          this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          this.container.appendChild(this.renderer.domElement);

          this.planetParticles = null;
          this.ringParticles = null;
          this.chaosMode = false;
          
          this.colorPalette = [
            new THREE.Color('#f8a5c2'),
            new THREE.Color('#f78fb3'),
            new THREE.Color('#f5cd79'),
            new THREE.Color('#ffffff')
          ];
          
          this.config = {
            planetRadius: 2.8,
            ringInnerRadius: 3.5,
            ringOuterRadius: 7.5,
            planetParticleCount: 10000,
            ringParticleCount: 20000,
            tilt: Math.PI / 6,
            rotationSpeed: 0.05
          };

          this.mouseX = 0;
          this.mouseY = 0;
          this.windowHalfX = window.innerWidth / 2;
          this.windowHalfY = window.innerHeight / 2;

          this.init();
          this.animate();
          this.addEventListeners();
          
          console.log('SaturnScene created successfully');
        }

        init() {
          this.camera.position.z = 14;
          this.camera.position.x = 0;
          
          this.planetGroup = new THREE.Group();
          this.scene.add(this.planetGroup);
          this.planetGroup.position.x = 4.5;

          this.createPlanet();
          this.createRings();

          this.planetGroup.rotation.z = this.config.tilt;
          this.planetGroup.rotation.x = 0.3;
        }

        createPlanet() {
          this.config.planetRadius = 3.5;
          
          const geometry = new THREE.BufferGeometry();
          const positions = [];
          const sizes = [];
          const brightness = [];
          const velocities = [];
          const colors = [];

          for (let i = 0; i < this.config.planetParticleCount; i++) {
            const r = this.config.planetRadius * Math.cbrt(Math.random());
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);

            const x = r * Math.sin(phi) * Math.cos(theta);
            const y = r * Math.sin(phi) * Math.sin(theta);
            const z = r * Math.cos(phi);

            positions.push(x, y, z);
            sizes.push(Math.random() * 0.05 + 0.01);
            brightness.push(Math.random());
            const v = 0.02 / Math.sqrt(r + 0.1);
            velocities.push(v);

            const color = this.colorPalette[Math.floor(Math.random() * this.colorPalette.length)];
            colors.push(color.r, color.g, color.b);
          }

          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
          geometry.setAttribute('size', new THREE.Float32BufferAttribute(sizes, 1));
          geometry.setAttribute('brightness', new THREE.Float32BufferAttribute(brightness, 1));
          geometry.setAttribute('velocity', new THREE.Float32BufferAttribute(velocities, 1));
          geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

          const material = new THREE.ShaderMaterial({
            uniforms: {
              uTime: { value: 0 },
              uScale: { value: 1.0 },
              uChaos: { value: 0.0 }
            },
            vertexShader: `
              attribute float size;
              attribute float brightness;
              attribute float velocity;
              attribute vec3 color;
              
              varying vec3 vColor;
              varying float vBrightness;
              
              uniform float uTime;
              uniform float uChaos;
              
              float random(vec3 st) {
                return fract(sin(dot(st.xyz, vec3(12.9898,78.233,45.5432))) * 43758.5453123);
              }

              void main() {
                vColor = color;
                vBrightness = brightness;
                
                vec3 pos = position;
                
                float angle = uTime * velocity;
                float s = sin(angle);
                float c = cos(angle);
                
                float x = pos.x * c - pos.z * s;
                float z = pos.x * s + pos.z * c;
                pos.x = x;
                pos.z = z;

                if (uChaos > 0.0) {
                   vec3 noise = vec3(
                     random(pos + uTime * 0.1),
                     random(pos + uTime * 0.1 + 10.0),
                     random(pos + uTime * 0.1 + 20.0)
                   );
                   pos += (noise - 0.5) * uChaos * 2.0;
                }

                vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
                gl_PointSize = size * (300.0 / -mvPosition.z);
                
                if (uChaos > 0.0) {
                    gl_PointSize *= (1.0 + random(pos * uTime) * uChaos);
                }

                gl_Position = projectionMatrix * mvPosition;
              }
            `,
            fragmentShader: `
              varying vec3 vColor;
              varying float vBrightness;
              
              void main() {
                vec2 coord = gl_PointCoord - vec2(0.5);
                if(length(coord) > 0.5) discard;
                float alpha = 0.8 * vBrightness + 0.2;
                gl_FragColor = vec4(vColor, alpha);
              }
            `,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending
          });

          this.planetParticles = new THREE.Points(geometry, material);
          this.planetGroup.add(this.planetParticles);
        }

        createRings() {
          const geometry = new THREE.BufferGeometry();
          const positions = [];
          const sizes = [];
          const velocities = [];
          const initialAngles = [];
          const colors = [];
          
          for (let i = 0; i < this.config.ringParticleCount; i++) {
            const r = this.config.ringInnerRadius + Math.random() * (this.config.ringOuterRadius - this.config.ringInnerRadius);
            const theta = Math.random() * Math.PI * 2;
            
            const x = r * Math.cos(theta);
            const y = (Math.random() - 0.5) * 0.1;
            const z = r * Math.sin(theta);

            positions.push(x, y, z);
            sizes.push(Math.random() * 0.03 + 0.005);
            
            const v = 0.5 / Math.sqrt(r);
            velocities.push(v);
            initialAngles.push(theta);

            const isPink = Math.random() > 0.7;
            const color = isPink ? new THREE.Color('#fda4af') : new THREE.Color('#ffffff');
            colors.push(color.r, color.g, color.b);
          }

          geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
          geometry.setAttribute('size', new THREE.Float32BufferAttribute(sizes, 1));
          geometry.setAttribute('velocity', new THREE.Float32BufferAttribute(velocities, 1));
          geometry.setAttribute('initialAngle', new THREE.Float32BufferAttribute(initialAngles, 1));
          geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

          const material = new THREE.ShaderMaterial({
            uniforms: {
              uTime: { value: 0 },
              uChaos: { value: 0.0 }
            },
            vertexShader: `
              attribute float size;
              attribute float velocity;
              attribute float initialAngle;
              attribute vec3 color;
              
              varying vec3 vColor;
              
              uniform float uTime;
              uniform float uChaos;
              
              float random(vec3 st) {
                return fract(sin(dot(st.xyz, vec3(12.9898,78.233,45.5432))) * 43758.5453123);
              }

              void main() {
                vColor = color;
                vec3 pos = position;
                
                float r = length(vec2(pos.x, pos.z));
                float currentAngle = initialAngle + velocity * uTime * 0.5;
                
                pos.x = r * cos(currentAngle);
                pos.z = r * sin(currentAngle);
                
                if (uChaos > 0.0) {
                   vec3 noise = vec3(
                     random(pos + uTime * 0.2),
                     random(pos + uTime * 0.2 + 30.0),
                     random(pos + uTime * 0.2 + 60.0)
                   );
                   pos += (noise - 0.5) * uChaos * 1.5;
                }

                vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
                gl_PointSize = size * (300.0 / -mvPosition.z);
                
                if (uChaos > 0.0) {
                    gl_PointSize *= (1.0 + random(pos * uTime) * uChaos);
                }

                gl_Position = projectionMatrix * mvPosition;
              }
            `,
            fragmentShader: `
              varying vec3 vColor;
              
              void main() {
                vec2 coord = gl_PointCoord - vec2(0.5);
                if(length(coord) > 0.5) discard;
                gl_FragColor = vec4(vColor, 0.6);
              }
            `,
            transparent: true,
            depthWrite: false,
            blending: THREE.AdditiveBlending
          });

          this.ringParticles = new THREE.Points(geometry, material);
          this.planetGroup.add(this.ringParticles);
        }

        animate() {
          requestAnimationFrame(() => this.animate());

          const time = performance.now() * 0.001;

          if (this.planetParticles) {
            this.planetParticles.material.uniforms.uTime.value = time;
            this.planetParticles.material.uniforms.uChaos.value = this.chaosMode ? 0.8 : 0.0;
          }
          if (this.ringParticles) {
            this.ringParticles.material.uniforms.uTime.value = time;
            this.ringParticles.material.uniforms.uChaos.value = this.chaosMode ? 0.8 : 0.0;
          }

          this.camera.position.x += (this.mouseX * 0.005 + 2 - this.camera.position.x) * 0.05;
          this.camera.position.y += (-this.mouseY * 0.005 - this.camera.position.y) * 0.05;
          this.camera.lookAt(0, 0, 0);

          this.renderer.render(this.scene, this.camera);
        }

        addEventListeners() {
          window.addEventListener('resize', () => {
            this.windowHalfX = window.innerWidth / 2;
            this.windowHalfY = window.innerHeight / 2;
            this.camera.aspect = window.innerWidth / window.innerHeight;
            this.camera.updateProjectionMatrix();
            this.renderer.setSize(window.innerWidth, window.innerHeight);
          });

          document.addEventListener('mousemove', (e) => {
            this.mouseX = (e.clientX - this.windowHalfX);
            this.mouseY = (e.clientY - this.windowHalfY);
          });
          
          document.addEventListener('mousedown', () => { this.chaosMode = true; });
          document.addEventListener('mouseup', () => { this.chaosMode = false; });
        }
      }

      console.log('Creating SaturnScene instance...');
      new SaturnScene();
      console.log('Saturn initialization complete!');
    } catch (error) {
      console.error('Error initializing Saturn:', error);
      console.error('Error stack:', error.stack);
    }
  }

  // Initialize when DOM is ready
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initSaturn();
      });
    } else {
      initSaturn();
    }
  }
</script>

