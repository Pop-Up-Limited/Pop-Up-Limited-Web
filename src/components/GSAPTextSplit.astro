---
interface Props {
  text: string;
  className?: string;
  delay?: number;
}

const { text, className = '', delay = 0 } = Astro.props;
---

<div class={`gsap-text-split ${className}`} data-text={text} data-delay={delay}>
  {text.split('').map((char, i) => (
    <span class="inline-block" data-char={i}>{char === ' ' ? '\u00A0' : char}</span>
  ))}
</div>

<script>
  import { gsap } from 'gsap';
  
  document.addEventListener('DOMContentLoaded', async () => {
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);

    const elements = document.querySelectorAll('.gsap-text-split');
    
    elements.forEach((el) => {
      const chars = el.querySelectorAll('[data-char]');
      const delay = parseFloat(el.getAttribute('data-delay') || '0');
      
      gsap.fromTo(chars, 
        {
          opacity: 0,
          y: 50,
          rotationX: -90
        },
        {
          opacity: 1,
          y: 0,
          rotationX: 0,
          duration: 0.8,
          stagger: 0.02,
          delay: delay,
          ease: 'back.out(1.7)',
          scrollTrigger: {
            trigger: el,
            start: 'top 80%',
            toggleActions: 'play none none none'
          }
        }
      );
    });
  });
</script>

<style>
  .gsap-text-split {
    display: inline-block;
    perspective: 1000px;
  }
  
  .gsap-text-split [data-char] {
    display: inline-block;
    transform-style: preserve-3d;
  }
</style>

