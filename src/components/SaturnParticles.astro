---
---
<div id="saturn-particles-container" class="absolute inset-0 z-0 overflow-hidden pointer-events-none translate-x-1/4 translate-y-[-10%]">
  <canvas id="saturn-canvas" class="w-full h-full opacity-90"></canvas>
</div>

<script>
  class SaturnParticleSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: Particle[];
    width: number;
    height: number;
    centerX: number;
    centerY: number;
    mouseX: number;
    mouseY: number;
    isHovering: boolean;

    // Saturn Configuration
    planetRadius: number;
    ringInnerRadius: number;
    ringOuterRadius: number;
    rotationAngle: number;

    constructor() {
      this.canvas = document.getElementById('saturn-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;
      
      const context = this.canvas.getContext('2d');
      if (!context) return;
      this.ctx = context;

      this.particles = [];
      this.width = 0;
      this.height = 0;
      this.centerX = 0;
      this.centerY = 0;
      this.mouseX = -1000;
      this.mouseY = -1000;
      this.isHovering = false;

      this.rotationAngle = Math.PI / 6; // Tilt angle (30 degrees)

      this.resize();
      this.initParticles();
      
      window.addEventListener('resize', () => {
          this.resize();
          this.initParticles();
      });
      
      // Global mouse tracking for interaction
      document.addEventListener('mousemove', (e) => {
        const rect = this.canvas.getBoundingClientRect();
        this.mouseX = e.clientX - rect.left;
        this.mouseY = e.clientY - rect.top;
        this.isHovering = true;
      });

      document.addEventListener('mouseleave', () => {
          this.isHovering = false;
          this.mouseX = -1000;
          this.mouseY = -1000;
      });

      this.animate();
    }

    resize() {
      this.width = this.canvas.width = this.canvas.offsetWidth;
      this.height = this.canvas.height = this.canvas.offsetHeight;
      this.centerX = this.width * 0.7; // Position right side
      this.centerY = this.height * 0.4; // Slightly upper
      
      // Scale based on screen size
      const minDim = Math.min(this.width, this.height);
      this.planetRadius = minDim * 0.12;
      this.ringInnerRadius = minDim * 0.18;
      this.ringOuterRadius = minDim * 0.35;
    }

    initParticles() {
      this.particles = [];
      const particleCount = 1200; // Total particles

      // 1. Planet Body Particles (Sphere)
      for (let i = 0; i < particleCount * 0.4; i++) {
          this.particles.push(new Particle(this, 'planet'));
      }

      // 2. Ring Particles (Disc)
      for (let i = 0; i < particleCount * 0.6; i++) {
          this.particles.push(new Particle(this, 'ring'));
      }
    }

    animate() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      
      this.particles.forEach(p => {
          p.update(this.mouseX, this.mouseY);
          p.draw(this.ctx);
      });
      
      requestAnimationFrame(() => this.animate());
    }
  }

  class Particle {
    system: SaturnParticleSystem;
    type: 'planet' | 'ring';
    
    // Target position (The shape)
    targetX: number;
    targetY: number;
    targetZ: number; // For depth sorting/parallax

    // Current position
    x: number;
    y: number;
    
    // Properties
    baseX: number;
    baseY: number;
    size: number;
    color: string;
    angle: number; // Orbit angle
    radius: number; // Orbit radius
    speed: number;
    
    density: number;

    constructor(system: SaturnParticleSystem, type: 'planet' | 'ring') {
      this.system = system;
      this.type = type;
      this.reset();
      this.x = Math.random() * system.width;
      this.y = Math.random() * system.height;
    }

    reset() {
      // Random angle for distribution
      this.angle = Math.random() * Math.PI * 2;
      this.speed = Math.random() * 0.002 + 0.0005; // Orbit speed

      if (this.type === 'planet') {
        // Distribute points on a sphere surface (roughly) projected to 2D circle with depth
        // Simple 2D circle distribution for visual simplicity, z used for sizing
        const r = Math.sqrt(Math.random()) * this.system.planetRadius;
        this.radius = r;
        this.targetZ = Math.cos(this.angle) * r; // Fake depth
        
        // Color: Pinkish Planet
        const colors = ['rgba(248, 147, 147, ', 'rgba(244, 114, 182, '];
        this.color = colors[Math.floor(Math.random() * colors.length)];

      } else {
        // Ring distribution
        const r = this.system.ringInnerRadius + Math.random() * (this.system.ringOuterRadius - this.system.ringInnerRadius);
        this.radius = r;
        this.targetZ = Math.sin(this.angle) * r * 0.5; // Rings are flat but tilted
        
        // Color: Lighter Pink/White Rings
        const colors = ['rgba(252, 165, 165, ', 'rgba(255, 255, 255, '];
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }

      this.size = Math.random() * 1.5 + 0.5;
      this.density = (Math.random() * 30) + 1;
    }

    update(mouseX: number, mouseY: number) {
      // 1. Orbit Animation (Move the target position)
      this.angle += this.speed;
      
      let tx, ty, tz;

      if (this.type === 'planet') {
          // Simple rotation
          tx = Math.cos(this.angle) * this.radius;
          ty = Math.sin(this.angle) * this.radius;
          tz = 0; // Simplify planet sphere
      } else {
          // Ring Logic (Elliptical projection based on tilt)
          const tilt = this.system.rotationAngle;
          // 3D coordinates of ring
          const x3d = Math.cos(this.angle) * this.radius;
          const z3d = Math.sin(this.angle) * this.radius;
          
          // Project to 2D with tilt
          tx = x3d;
          ty = z3d * Math.sin(tilt); 
          tz = z3d * Math.cos(tilt); // Use Z for scale/opacity later if needed
      }

      // Center offset
      this.targetX = this.system.centerX + tx;
      this.targetY = this.system.centerY + ty;

      // 2. Mouse Interaction (Disperse)
      const dx = mouseX - this.x;
      const dy = mouseY - this.y;
      const distance = Math.sqrt(dx * dx + dy * dy);
      const forceDistance = 120;
      
      // Soft return speed
      const returnSpeed = 0.08;

      if (distance < forceDistance) {
          // Scatter effect
          const forceDirectionX = dx / distance;
          const forceDirectionY = dy / distance;
          const force = (forceDistance - distance) / forceDistance;
          const directionX = forceDirectionX * force * this.density * 2; // Stronger scatter
          const directionY = forceDirectionY * force * this.density * 2;
          
          this.x -= directionX;
          this.y -= directionY;
      } else {
          // Return to shape
          if (this.x !== this.targetX) {
              const dx = this.targetX - this.x;
              this.x += dx * returnSpeed;
          }
          if (this.y !== this.targetY) {
              const dy = this.targetY - this.y;
              this.y += dy * returnSpeed;
          }
      }
    }

    draw(ctx: CanvasRenderingContext2D) {
      const alpha = Math.random() * 0.5 + 0.4;
      ctx.fillStyle = this.color + alpha + ')';
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new SaturnParticleSystem();
  });
</script>

