---
---
<div id="saturn-particles-container" class="absolute inset-0 z-0 overflow-hidden pointer-events-none translate-x-0 translate-y-0">
  <canvas id="saturn-canvas" class="w-full h-full opacity-100"></canvas>
</div>

<script>
  class SaturnParticleSystem {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    particles: Particle[];
    width: number;
    height: number;
    centerX: number;
    centerY: number;
    mouseX: number;
    mouseY: number;
    isHovering: boolean;
    animationFrameId: number;

    // Saturn Configuration
    planetRadius: number;
    ringInnerRadius: number;
    ringOuterRadius: number;
    rotationAngle: number;

    constructor() {
      this.canvas = document.getElementById('saturn-canvas') as HTMLCanvasElement;
      if (!this.canvas) return;
      
      const context = this.canvas.getContext('2d');
      if (!context) return;
      this.ctx = context;

      this.particles = [];
      this.width = 0;
      this.height = 0;
      this.mouseX = -1000;
      this.mouseY = -1000;
      this.isHovering = false;

      // Tilted perspective
      this.rotationAngle = Math.PI / 6; // 30 degrees tilt

      this.resize();
      
      // Debounced resize
      let resizeTimeout;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
            this.resize();
        }, 200);
      });
      
      document.addEventListener('mousemove', (e) => {
        const rect = this.canvas.getBoundingClientRect();
        this.mouseX = e.clientX - rect.left;
        this.mouseY = e.clientY - rect.top;
        this.isHovering = true;
      });

      document.addEventListener('mouseleave', () => {
          this.isHovering = false;
          this.mouseX = -1000;
          this.mouseY = -1000;
      });

      this.animate();
    }

    resize() {
      this.width = this.canvas.width = this.canvas.offsetWidth;
      this.height = this.canvas.height = this.canvas.offsetHeight;
      
      // Position it aggressively to the right side, overlapping content if needed
      // The user wants it "large" and occupying "3/4 of the right half"
      this.centerX = this.width * 0.75; 
      this.centerY = this.height * 0.5;
      
      const minDim = Math.min(this.width, this.height);
      
      // Significantly increased sizes
      this.planetRadius = minDim * 0.35; 
      this.ringInnerRadius = minDim * 0.45;
      this.ringOuterRadius = minDim * 0.85;

      this.initParticles();
    }

    initParticles() {
      this.particles = [];
      const particleCount = 5000; // Increased density

      // 1. Planet Body
      for (let i = 0; i < particleCount * 0.35; i++) {
          this.particles.push(new Particle(this, 'planet'));
      }

      // 2. Rings
      for (let i = 0; i < particleCount * 0.65; i++) {
          this.particles.push(new Particle(this, 'ring'));
      }
    }

    animate() {
      this.ctx.clearRect(0, 0, this.width, this.height);
      
      this.particles.forEach(p => {
          p.update(this.mouseX, this.mouseY);
          p.draw(this.ctx);
      });
      
      this.animationFrameId = requestAnimationFrame(() => this.animate());
    }
  }

  class Particle {
    system: SaturnParticleSystem;
    type: 'planet' | 'ring';
    
    targetX: number;
    targetY: number;
    
    x: number;
    y: number;
    
    size: number;
    color: string;
    angle: number;
    radius: number;
    speed: number;
    offsetY: number; // For planet sphere height
    
    density: number;

    constructor(system: SaturnParticleSystem, type: 'planet' | 'ring') {
      this.system = system;
      this.type = type;
      this.reset();
      this.x = Math.random() * system.width;
      this.y = Math.random() * system.height;
    }

    reset() {
      this.angle = Math.random() * Math.PI * 2;
      this.speed = (Math.random() * 0.001) + 0.0002; 

      if (this.type === 'planet') {
        const r = this.system.planetRadius * Math.cbrt(Math.random()); 
        this.radius = r;
        this.offsetY = (Math.random() - 0.5) * 2 * r; 
        
        // Adjust radius to maintain spherical shape appearance projected
        const sliceRadius = Math.sqrt(Math.max(0, r*r - this.offsetY*this.offsetY));
        this.radius = sliceRadius;

        // Deep Pink / Brand Colors for Planet Body
        const colors = [
            'rgba(248, 147, 147, ', // Brand Main
            'rgba(251, 113, 133, ', // Rose
            'rgba(244, 114, 182, ', // Pink
            'rgba(225, 29, 72, '    // Darker Red/Pink for contrast
        ];
        this.color = colors[Math.floor(Math.random() * colors.length)];

      } else {
        // Rings
        const r = this.system.ringInnerRadius + Math.random() * (this.system.ringOuterRadius - this.system.ringInnerRadius);
        this.radius = r;
        this.offsetY = 0;
        
        // Ring Colors: White/Light Pink
        const colors = [
            'rgba(255, 255, 255, ',
            'rgba(252, 165, 165, ', 
            'rgba(254, 205, 211, '  
        ];
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }

      // Increased particle size for visibility
      this.size = Math.random() * 2.5 + 0.5; 
      this.density = (Math.random() * 20) + 1;
    }

    update(mouseX: number, mouseY: number) {
      this.angle += this.speed;
      
      let tx, ty;

      if (this.type === 'planet') {
          tx = Math.cos(this.angle) * this.radius;
          ty = this.offsetY; 
          
          // Apply tilt
          const tilt = this.system.rotationAngle;
          const yRotated = ty * Math.cos(tilt) - Math.sin(this.angle) * this.radius * Math.sin(tilt);
          ty = yRotated;
      } else {
          // Rings
          const tilt = this.system.rotationAngle;
          tx = Math.cos(this.angle) * this.radius;
          ty = Math.sin(this.angle) * this.radius * Math.sin(tilt); 
      }

      this.targetX = this.system.centerX + tx;
      this.targetY = this.system.centerY + ty;

      // Interaction
      const dx = mouseX - this.x;
      const dy = mouseY - this.y;
      const distance = Math.sqrt(dx * dx + dy * dy);
      const forceDistance = 200; // Larger interactive area
      const returnSpeed = 0.08; 

      if (distance < forceDistance) {
          const force = (forceDistance - distance) / forceDistance;
          const directionX = (dx / distance) * force * this.density * 5;
          const directionY = (dy / distance) * force * this.density * 5;
          
          this.x -= directionX;
          this.y -= directionY;
      } else {
          this.x += (this.targetX - this.x) * returnSpeed;
          this.y += (this.targetY - this.y) * returnSpeed;
      }
    }

    draw(ctx: CanvasRenderingContext2D) {
      ctx.fillStyle = this.color + '0.9)'; // High opacity to avoid flickering
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    new SaturnParticleSystem();
  });
</script>
