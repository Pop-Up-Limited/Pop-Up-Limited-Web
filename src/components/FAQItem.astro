---
import type { FAQ } from '../data/faqs';

interface Props {
  item: FAQ;
  index: number;
}

const { item, index } = Astro.props;
const summaryId = `faq-${index}-summary`;
const contentId = `faq-${index}-content`;
---

<details class="group rounded-2xl border border-white/20 bg-white/5 p-5 transition hover:border-purple-400/50 hover:bg-white/10">
  <summary
    id={summaryId}
    class="flex cursor-pointer items-center justify-between gap-4 text-left text-base font-semibold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-400"
    aria-controls={contentId}
  >
    {item.question}
    <span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/30 text-white/70 transition group-open:rotate-45 group-open:bg-purple-500 group-open:text-white group-open:border-purple-500">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
      </svg>
    </span>
  </summary>

  <div id={contentId} class="mt-3 text-sm leading-relaxed text-gray-300">
    {item.answer}
  </div>
</details>
