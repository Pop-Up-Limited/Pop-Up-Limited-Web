---
// GSAP Animation Controller - Enhanced version with more effects
// Inspired by madewithgsap.com
---

<script>
  import { gsap } from 'gsap';
  
  document.addEventListener('DOMContentLoaded', async () => {
    // Dynamically import ScrollTrigger
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);
    
    console.log('GSAP Animations v2 initialized');

    // 1. Hero Title Animation - Cinematic text reveal
    const heroTitle = document.querySelector('h1[data-i18n="hero.title"]');
    if (heroTitle) {
      const text = heroTitle.textContent || '';
      heroTitle.innerHTML = '';
      
      // Split into characters with spans
      text.split('').forEach((char, i) => {
        const span = document.createElement('span');
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.display = 'inline-block';
        span.style.opacity = '0';
        span.style.transform = 'translateY(100px) rotateX(-90deg)';
        span.classList.add('hero-char');
        heroTitle.appendChild(span);
      });

      // Staggered character animation
      gsap.to('.hero-char', {
        opacity: 1,
        y: 0,
        rotateX: 0,
        duration: 0.8,
        stagger: 0.03,
        ease: 'back.out(1.7)',
        delay: 0.5
      });
    }

    // 2. Hero subtitle fade in
    const heroSubtitle = document.querySelector('p[data-i18n="hero.subtitle"]');
    if (heroSubtitle) {
      gsap.fromTo(heroSubtitle,
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 1, delay: 1.2, ease: 'power3.out' }
      );
    }

    // 3. Hero buttons staggered entrance
    const heroButtons = document.querySelectorAll('.btn-primary, .btn-secondary');
    gsap.fromTo(heroButtons,
      { opacity: 0, y: 20, scale: 0.9 },
      { 
        opacity: 1, 
        y: 0, 
        scale: 1, 
        duration: 0.6, 
        stagger: 0.15, 
        delay: 1.5, 
        ease: 'back.out(1.5)' 
      }
    );

    // 4. Section titles - slide in with line reveal
    const sectionTitles = document.querySelectorAll('h2[data-i18n]');
    sectionTitles.forEach(title => {
      // Create line element
      const line = document.createElement('div');
      line.className = 'title-underline';
      line.style.cssText = 'position: absolute; bottom: -8px; left: 0; width: 0; height: 3px; background: linear-gradient(90deg, #a855f7, #c084fc); border-radius: 2px;';
      
      const wrapper = title.parentElement;
      if (wrapper) {
        wrapper.style.position = 'relative';
        wrapper.appendChild(line);
      }

      gsap.fromTo(title,
        { opacity: 0, x: -50 },
        {
          opacity: 1,
          x: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: title,
            start: 'top 85%',
            toggleActions: 'play none none none'
          },
          onComplete: () => {
            gsap.to(line, { width: '60px', duration: 0.5, ease: 'power2.out' });
          }
        }
      );
    });

    // 5. Cards - 3D flip entrance
    const cards = document.querySelectorAll('.card-surface');
    cards.forEach((card, index) => {
      gsap.fromTo(card,
        { 
          opacity: 0, 
          y: 80, 
          rotateY: -15,
          scale: 0.9
        },
        {
          opacity: 1,
          y: 0,
          rotateY: 0,
          scale: 1,
          duration: 0.8,
          delay: index * 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    });

    // 6. Portfolio cards - stacking with parallax
    const portfolioCards = document.querySelectorAll('.card-stack-item');
    portfolioCards.forEach((card, index) => {
      gsap.fromTo(card,
        { 
          opacity: 0, 
          y: 100 + (index * 20),
          scale: 0.85
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 1,
          ease: 'power4.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 90%',
            end: 'top 20%',
            scrub: 0.5
          }
        }
      );
    });

    // 7. Magnetic button effect - enhanced
    const buttons = document.querySelectorAll('.btn-primary, .btn-secondary');
    buttons.forEach(btn => {
      let bounds;
      
      const updateBounds = () => {
        bounds = btn.getBoundingClientRect();
      };
      
      updateBounds();
      window.addEventListener('resize', updateBounds);

      btn.addEventListener('mouseenter', () => {
        gsap.to(btn, { 
          scale: 1.08, 
          duration: 0.4, 
          ease: 'elastic.out(1, 0.5)',
          boxShadow: '0 10px 40px rgba(168, 85, 247, 0.4)'
        });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { 
          scale: 1, 
          x: 0, 
          y: 0, 
          duration: 0.4, 
          ease: 'elastic.out(1, 0.5)',
          boxShadow: ''
        });
      });

      btn.addEventListener('mousemove', (e) => {
        updateBounds();
        const x = e.clientX - bounds.left - bounds.width / 2;
        const y = e.clientY - bounds.top - bounds.height / 2;
        gsap.to(btn, { 
          x: x * 0.3, 
          y: y * 0.3, 
          duration: 0.3, 
          ease: 'power2.out' 
        });
      });
    });

    // 8. Counter animation with enhanced easing
    const counterElements = document.querySelectorAll('.text-5xl.font-bold');
    counterElements.forEach(el => {
      const text = el.textContent || '';
      const match = text.match(/(\d+)/);
      if (match) {
        const endValue = parseInt(match[1]);
        const suffix = text.replace(/\d+/, '');
        
        ScrollTrigger.create({
          trigger: el,
          start: 'top 80%',
          onEnter: () => {
            const obj = { value: 0 };
            gsap.to(obj, {
              value: endValue,
              duration: 2.5,
              ease: 'power4.out',
              onUpdate: () => {
                el.textContent = Math.round(obj.value) + suffix;
              }
            });
            // Add glow effect
            gsap.fromTo(el, 
              { textShadow: '0 0 0px rgba(168, 85, 247, 0)' },
              { textShadow: '0 0 30px rgba(168, 85, 247, 0.5)', duration: 1, yoyo: true, repeat: 1 }
            );
          },
          once: true
        });
      }
    });

    // 9. Parallax effect on hero
    const heroSection = document.querySelector('section:first-of-type');
    if (heroSection) {
      gsap.to(heroSection, {
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true
        },
        y: 150,
        opacity: 0.3,
        scale: 0.95,
        ease: 'none'
      });
    }

    // 10. Smooth reveal for grid items
    const gridContainers = document.querySelectorAll('.grid.gap-6');
    gridContainers.forEach(grid => {
      const items = grid.children;
      gsap.fromTo(items,
        { 
          opacity: 0, 
          y: 60,
          rotateX: -10
        },
        {
          opacity: 1,
          y: 0,
          rotateX: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 80%',
            toggleActions: 'play none none none'
          }
        }
      );
    });

    // 11. Text scramble effect for badge
    const badge = document.querySelector('[data-i18n="hero.badge"]');
    if (badge) {
      const originalText = badge.textContent || '';
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let iterations = 0;
      
      setTimeout(() => {
        const scramble = setInterval(() => {
          badge.textContent = originalText
            .split('')
            .map((char, index) => {
              if (index < iterations) return originalText[index];
              if (char === ' ') return ' ';
              return chars[Math.floor(Math.random() * chars.length)];
            })
            .join('');
          
          if (iterations >= originalText.length) {
            clearInterval(scramble);
          }
          iterations += 0.5;
        }, 30);
      }, 300);
    }

    // 12. Quote section special animation
    const quoteSection = document.querySelector('[data-i18n="about.quote"]');
    if (quoteSection) {
      gsap.fromTo(quoteSection,
        { 
          opacity: 0, 
          scale: 0.9,
          filter: 'blur(10px)'
        },
        {
          opacity: 1,
          scale: 1,
          filter: 'blur(0px)',
          duration: 1.2,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: quoteSection,
            start: 'top 80%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    // 13. CTA section entrance
    const ctaSection = document.querySelector('.rounded-3xl.border-brand-400');
    if (ctaSection) {
      gsap.fromTo(ctaSection,
        { 
          opacity: 0, 
          y: 100,
          scale: 0.9
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 1,
          ease: 'power4.out',
          scrollTrigger: {
            trigger: ctaSection,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    // 14. Danmaku hover pause
    const danmakuItems = document.querySelectorAll('.animate-marquee, .animate-marquee-reverse');
    danmakuItems.forEach(item => {
      item.addEventListener('mouseenter', () => {
        item.style.animationPlayState = 'paused';
      });
      item.addEventListener('mouseleave', () => {
        item.style.animationPlayState = 'running';
      });
    });

    // 15. Image hover zoom effect
    const images = document.querySelectorAll('.card-stack-item img');
    images.forEach(img => {
      const parent = img.parentElement;
      if (parent) {
        parent.addEventListener('mouseenter', () => {
          gsap.to(img, { scale: 1.1, duration: 0.6, ease: 'power2.out' });
        });
        parent.addEventListener('mouseleave', () => {
          gsap.to(img, { scale: 1, duration: 0.6, ease: 'power2.out' });
        });
      }
    });

    // 16. Smooth scroll indicator
    const scrollIndicator = document.createElement('div');
    scrollIndicator.className = 'scroll-progress';
    scrollIndicator.style.cssText = 'position: fixed; top: 0; left: 0; height: 3px; background: linear-gradient(90deg, #a855f7, #c084fc); z-index: 9999; width: 0%;';
    document.body.appendChild(scrollIndicator);

    gsap.to(scrollIndicator, {
      width: '100%',
      ease: 'none',
      scrollTrigger: {
        trigger: document.body,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.3
      }
    });

  });
</script>

<style is:global>
  /* Ensure hero title has perspective for 3D effect */
  h1[data-i18n="hero.title"] {
    perspective: 1000px;
  }
  
  .hero-char {
    display: inline-block;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  
  /* Smooth transitions for all animated elements */
  .card-surface,
  .btn-primary,
  .btn-secondary,
  .rounded-3xl,
  .card-stack-item {
    will-change: transform, opacity;
    transform-style: preserve-3d;
  }
  
  /* Title underline animation base */
  .title-underline {
    transition: width 0.5s ease;
  }
  
  /* Scroll progress bar */
  .scroll-progress {
    transition: none;
  }
  
  /* Enhanced card hover glow */
  .card-surface:hover,
  .card-stack-item:hover {
    box-shadow: 0 20px 60px rgba(168, 85, 247, 0.2) !important;
  }
</style>
