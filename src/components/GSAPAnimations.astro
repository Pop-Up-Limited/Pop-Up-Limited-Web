---
// GSAP Animation Controller
// This component adds animations via CSS classes without wrapping existing content
---

<script>
  import { gsap } from 'gsap';
  
  document.addEventListener('DOMContentLoaded', async () => {
    // Dynamically import ScrollTrigger
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);
    
    console.log('GSAP Animations initialized');

    // 1. Hero Title Animation - Split text effect like madewithgsap.com
    const heroTitle = document.querySelector('h1[data-i18n="hero.title"]');
    if (heroTitle) {
      const text = heroTitle.textContent || '';
      heroTitle.innerHTML = '';
      
      // Split into characters
      text.split('').forEach((char, i) => {
        const span = document.createElement('span');
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.display = 'inline-block';
        span.style.opacity = '0';
        span.style.transform = 'translateY(50px) rotateX(-90deg)';
        span.classList.add('hero-char');
        heroTitle.appendChild(span);
      });

      // Animate characters
      gsap.to('.hero-char', {
        opacity: 1,
        y: 0,
        rotateX: 0,
        duration: 0.6,
        stagger: 0.02,
        ease: 'back.out(1.7)',
        delay: 0.3
      });
    }

    // 2. Scroll-triggered fade-in animations for sections
    // Add animations to cards and sections without modifying their structure
    const animateOnScroll = (selector, options = {}) => {
      const elements = document.querySelectorAll(selector);
      elements.forEach((el, index) => {
        gsap.fromTo(el, 
          { 
            opacity: 0, 
            y: options.y || 40,
            scale: options.scale || 1
          },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: options.duration || 0.8,
            delay: options.stagger ? index * options.stagger : 0,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 85%',
              toggleActions: 'play none none none'
            }
          }
        );
      });
    };

    // Apply to Why Us cards
    animateOnScroll('.card-surface', { stagger: 0.1, y: 60 });
    
    // Apply to section titles
    animateOnScroll('h2[data-i18n]', { y: 30 });

    // 3. Magnetic button effect - like madewithgsap.com
    const buttons = document.querySelectorAll('.btn-primary, .btn-secondary');
    buttons.forEach(btn => {
      let bounds;
      
      const updateBounds = () => {
        bounds = btn.getBoundingClientRect();
      };
      
      updateBounds();
      window.addEventListener('resize', updateBounds);

      btn.addEventListener('mouseenter', () => {
        gsap.to(btn, { scale: 1.05, duration: 0.3, ease: 'power2.out' });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { scale: 1, x: 0, y: 0, duration: 0.3, ease: 'power2.out' });
      });

      btn.addEventListener('mousemove', (e) => {
        updateBounds();
        const x = e.clientX - bounds.left - bounds.width / 2;
        const y = e.clientY - bounds.top - bounds.height / 2;
        gsap.to(btn, { x: x * 0.2, y: y * 0.2, duration: 0.3, ease: 'power2.out' });
      });
    });

    // 4. Parallax effect on scroll for hero section
    const heroSection = document.querySelector('section:first-of-type');
    if (heroSection) {
      gsap.to(heroSection, {
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true
        },
        y: 100,
        opacity: 0.5,
        ease: 'none'
      });
    }

    // 5. Counter animation for statistics
    const counterElements = document.querySelectorAll('.text-5xl.font-bold');
    counterElements.forEach(el => {
      const text = el.textContent || '';
      const match = text.match(/(\d+)/);
      if (match) {
        const endValue = parseInt(match[1]);
        const suffix = text.replace(/\d+/, '');
        
        ScrollTrigger.create({
          trigger: el,
          start: 'top 80%',
          onEnter: () => {
            const obj = { value: 0 };
            gsap.to(obj, {
              value: endValue,
              duration: 2,
              ease: 'power2.out',
              onUpdate: () => {
                el.textContent = Math.round(obj.value) + suffix;
              }
            });
          },
          once: true
        });
      }
    });

    // 6. Staggered reveal for grid items
    const gridContainers = document.querySelectorAll('.grid.gap-6');
    gridContainers.forEach(grid => {
      const items = grid.children;
      gsap.fromTo(items,
        { opacity: 0, y: 50 },
        {
          opacity: 1,
          y: 0,
          duration: 0.6,
          stagger: 0.15,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 80%',
            toggleActions: 'play none none none'
          }
        }
      );
    });

    // 7. Smooth hover effect for cards
    const cards = document.querySelectorAll('.card-surface, .rounded-3xl');
    cards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        gsap.to(card, {
          scale: 1.02,
          boxShadow: '0 20px 40px rgba(0,0,0,0.15)',
          duration: 0.3,
          ease: 'power2.out'
        });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          scale: 1,
          boxShadow: '',
          duration: 0.3,
          ease: 'power2.out'
        });
      });
    });

    // 8. Text scramble effect for badge
    const badge = document.querySelector('[data-i18n="hero.badge"]');
    if (badge) {
      const originalText = badge.textContent || '';
      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      let iterations = 0;
      
      const scramble = setInterval(() => {
        badge.textContent = originalText
          .split('')
          .map((char, index) => {
            if (index < iterations) return originalText[index];
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join('');
        
        if (iterations >= originalText.length) {
          clearInterval(scramble);
        }
        iterations += 1/3;
      }, 30);
    }

    // 9. Marquee/Danmaku speed enhancement
    const marquees = document.querySelectorAll('.animate-marquee, .animate-marquee-reverse');
    marquees.forEach(marquee => {
      marquee.addEventListener('mouseenter', () => {
        gsap.to(marquee, { animationPlayState: 'paused' });
      });
      marquee.addEventListener('mouseleave', () => {
        gsap.to(marquee, { animationPlayState: 'running' });
      });
    });

  });
</script>

<style is:global>
  /* Ensure hero title has perspective for 3D effect */
  h1[data-i18n="hero.title"] {
    perspective: 1000px;
  }
  
  .hero-char {
    display: inline-block;
    transform-style: preserve-3d;
  }
  
  /* Smooth transitions for all animated elements */
  .card-surface,
  .btn-primary,
  .btn-secondary,
  .rounded-3xl {
    will-change: transform;
  }
</style>

