---
// Splash Screen - Opening animation with Saturn
---

<div id="splash-screen" class="fixed inset-0 z-[10000] flex items-center justify-center bg-[#0a0515]">
  <!-- Saturn Animation Container -->
  <div class="splash-saturn-container">
    <!-- Core Planet -->
    <div class="splash-planet"></div>
    <!-- Rings -->
    <div class="splash-ring splash-ring-1"></div>
    <div class="splash-ring splash-ring-2"></div>
    <div class="splash-ring splash-ring-3"></div>
    <!-- Particles -->
    <div class="splash-particles">
      {Array.from({ length: 30 }).map((_, i) => (
        <div class="splash-particle" style={`--delay: ${i * 0.05}s; --angle: ${i * 12}deg; --distance: ${60 + Math.random() * 40}px;`}></div>
      ))}
    </div>
    <!-- Glow -->
    <div class="splash-glow"></div>
  </div>
  
  <!-- Logo Text (appears after planet animation) -->
  <div class="splash-logo">
    <span class="splash-logo-text">POP UP</span>
  </div>
</div>

<style>
  #splash-screen {
    transition: opacity 0.8s ease-out, visibility 0.8s ease-out;
  }
  
  #splash-screen.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  
  .splash-saturn-container {
    position: relative;
    width: 200px;
    height: 200px;
    animation: splash-zoom 2s ease-out forwards;
  }
  
  @keyframes splash-zoom {
    0% {
      transform: scale(0.3) rotate(-30deg);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    50% {
      transform: scale(1.2) rotate(10deg);
    }
    70% {
      transform: scale(0.9) rotate(-5deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }
  
  .splash-planet {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60px;
    height: 60px;
    background: radial-gradient(circle at 30% 30%, #c084fc, #7c3aed 50%, #3E1D82 100%);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 
      0 0 40px rgba(168, 85, 247, 0.6),
      0 0 80px rgba(168, 85, 247, 0.4),
      inset -10px -10px 20px rgba(0, 0, 0, 0.3);
    animation: splash-planet-pulse 1s ease-in-out infinite alternate;
  }
  
  @keyframes splash-planet-pulse {
    0% {
      box-shadow: 
        0 0 40px rgba(168, 85, 247, 0.6),
        0 0 80px rgba(168, 85, 247, 0.4),
        inset -10px -10px 20px rgba(0, 0, 0, 0.3);
    }
    100% {
      box-shadow: 
        0 0 60px rgba(168, 85, 247, 0.8),
        0 0 100px rgba(168, 85, 247, 0.5),
        inset -10px -10px 20px rgba(0, 0, 0, 0.3);
    }
  }
  
  .splash-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    border: 2px solid transparent;
    transform: translate(-50%, -50%) rotateX(75deg);
    animation: splash-ring-rotate 3s linear infinite;
  }
  
  .splash-ring-1 {
    width: 120px;
    height: 120px;
    border-color: rgba(168, 85, 247, 0.8);
    animation-duration: 2s;
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
  }
  
  .splash-ring-2 {
    width: 140px;
    height: 140px;
    border-color: rgba(192, 132, 252, 0.6);
    animation-duration: 2.5s;
    animation-direction: reverse;
    box-shadow: 0 0 15px rgba(192, 132, 252, 0.4);
  }
  
  .splash-ring-3 {
    width: 160px;
    height: 160px;
    border-color: rgba(216, 180, 254, 0.4);
    animation-duration: 3s;
    box-shadow: 0 0 20px rgba(216, 180, 254, 0.3);
  }
  
  @keyframes splash-ring-rotate {
    0% {
      transform: translate(-50%, -50%) rotateX(75deg) rotateZ(0deg);
    }
    100% {
      transform: translate(-50%, -50%) rotateX(75deg) rotateZ(360deg);
    }
  }
  
  .splash-particles {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
  }
  
  .splash-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: #c084fc;
    border-radius: 50%;
    animation: splash-particle-orbit 1.5s ease-in-out infinite;
    animation-delay: var(--delay);
    box-shadow: 0 0 6px rgba(192, 132, 252, 0.8);
  }
  
  @keyframes splash-particle-orbit {
    0% {
      transform: rotate(var(--angle)) translateX(var(--distance)) scale(0);
      opacity: 0;
    }
    50% {
      transform: rotate(calc(var(--angle) + 180deg)) translateX(var(--distance)) scale(1);
      opacity: 1;
    }
    100% {
      transform: rotate(calc(var(--angle) + 360deg)) translateX(var(--distance)) scale(0);
      opacity: 0;
    }
  }
  
  .splash-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.3) 0%, transparent 70%);
    transform: translate(-50%, -50%);
    animation: splash-glow-pulse 1.5s ease-in-out infinite;
  }
  
  @keyframes splash-glow-pulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.5;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.2);
      opacity: 0.8;
    }
  }
  
  .splash-logo {
    position: absolute;
    bottom: 30%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: splash-logo-appear 0.8s ease-out 1s forwards;
  }
  
  .splash-logo-text {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    color: white;
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.8);
  }
  
  @keyframes splash-logo-appear {
    0% {
      opacity: 0;
      transform: translateX(-50%) translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const splash = document.getElementById('splash-screen');
    const mainContent = document.querySelector('main');
    const navbar = document.querySelector('header');
    const footer = document.querySelector('footer');
    
    // Hide main content initially
    if (mainContent) {
      mainContent.style.opacity = '0';
      mainContent.style.transition = 'opacity 0.8s ease-out';
    }
    if (navbar) {
      navbar.style.opacity = '0';
      navbar.style.transition = 'opacity 0.8s ease-out';
    }
    if (footer) {
      footer.style.opacity = '0';
      footer.style.transition = 'opacity 0.8s ease-out';
    }
    
    // After 2 seconds, hide splash and show content
    setTimeout(() => {
      if (splash) {
        splash.classList.add('hidden');
      }
      
      // Fade in main content
      setTimeout(() => {
        if (mainContent) mainContent.style.opacity = '1';
        if (navbar) navbar.style.opacity = '1';
        if (footer) footer.style.opacity = '1';
      }, 200);
      
      // Remove splash from DOM after animation
      setTimeout(() => {
        if (splash) {
          splash.remove();
        }
      }, 1000);
    }, 2000);
  });
</script>

