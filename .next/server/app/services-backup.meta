{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/services-backup/layout,_N_T_/services-backup/page,_N_T_/services-backup"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/services-backup/__PAGE__",
    "/services-backup",
    "/_index",
    "/_head"
  ]
}